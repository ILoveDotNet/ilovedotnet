            <h4 id="implementing-wiremock-net">Implementing WireMock.NET</h4>

        <p>
            We will be using the same project we used in the previous article and <Highlight>try adding WireMock.NET setup</Highlight>. The steps 
            to implement WireMock.NET in functional test are as follows:
        </p>

        <ol>
            <li>
                <p>
                    Add reference to <Highlight CssClasses="[ break-all ]">WireMock.NET</Highlight> Nuget Package in 
                    <Highlight CssClasses="[ break-all ]">FunctionalTest.csproj</Highlight>.
                </p>
            </li>
            <li>
                <p>
                    Extend the <Highlight>xUnit.net v3 AppFixture</Highlight> from the
                    <NavLink href="blogs/using-docker-test-containers-in-functional-testing-in-asp-net-webapi">Testcontainers article</NavLink>
                    to own the WireMock server as well as PostgreSQL. Replace the previous fixture with this combined version,
                    keeping only one assembly-fixture registration.
                </p>
                <p>
                    The examples below target <Highlight>.NET 11</Highlight> and use <Highlight>EF Core 11.0.0</Highlight>.
                    If starting from the linked sample's older configuration, first complete the
                    <NavLink href="blogs/using-docker-test-containers-in-functional-testing-in-asp-net-webapi#functional-test-prerequisites">coordinated package and xUnit v3 migration</NavLink>
                    for the API and test projects.
                </p>

                <CodeSnippet CssClass="language-csharp">
using API.DbContexts;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.AspNetCore.TestHost;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Infrastructure;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Testcontainers.PostgreSql;
using WireMock.Server;
using WireMock.Settings;
using Xunit;

[assembly: AssemblyFixture(typeof(FunctionalTest.AppFixture))]
[assembly: CollectionBehavior(DisableTestParallelization = true)]
namespace FunctionalTest;
public class AppFixture : WebApplicationFactory&lt;Program&gt;, IAsyncLifetime
{
    private readonly PostgreSqlContainer _dbContainer =
        new PostgreSqlBuilder("postgres:17-alpine")
        .WithDatabase("ILoveDotNet")
        .WithUsername("postgres")
        .WithPassword("postgres")
        .Build();

    public string PostgresConnectionString =&gt; _dbContainer.GetConnectionString();
    public WireMockServer WeatherService { get; private set; } = null!;
    public string WeatherServiceUrl =&gt; WeatherService.Urls[0];

    protected override void ConfigureWebHost(IWebHostBuilder builder)
    {
        builder.UseEnvironment("Test");
        builder.ConfigureAppConfiguration((_, conf) =&gt;
        {
            conf.AddInMemoryCollection(new Dictionary&lt;string, string?&gt;
            {
                ["WeatherAPIUrl"] = $"{WeatherServiceUrl}/"
            });
        });
        builder.ConfigureTestServices(services =&gt;
        {
            services.RemoveAll&lt;WeatherForecastDbContext&gt;();
            services.RemoveAll&lt;DbContextOptions&lt;WeatherForecastDbContext&gt;&gt;();
            services.RemoveAll&lt;IDbContextOptionsConfiguration&lt;WeatherForecastDbContext&gt;&gt;();
            services.AddDbContext&lt;WeatherForecastDbContext&gt;(opts =&gt;
                opts.UseNpgsql(PostgresConnectionString));
        });
    }

    public async ValueTask InitializeAsync()
    {
        WeatherService = WireMockServer.Start(new WireMockServerSettings { UseSSL = false });
        await _dbContainer.StartAsync();
        await using var scope = Services.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService&lt;WeatherForecastDbContext&gt;();
        await db.Database.MigrateAsync();
        await DatabaseHelper.InitializeDbForTestsAsync(db);
    }

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        await _dbContainer.DisposeAsync();
        if (WeatherService is not null)
        {
            WeatherService.Stop();
            WeatherService.Dispose();
        }
    }
}
                </CodeSnippet>

                

                <p>
                    In the above code, we are <Highlight>initializing</Highlight> the <Highlight>WireMockServer</Highlight> and 
                    getting the <Highlight>Server Base URL</Highlight> from the WireMockServer and exposing it to be used in 
                    <Highlight>ConfigureAppConfiguration</Highlight> in <Highlight>AppFixture</Highlight> to
                    <Highlight>override</Highlight> with this URL. We can also configure <Highlight>SSL</Highlight>, 
                    <Highlight>port</Highlight>, etc during initialization here. We are also <Highlight>disposing</Highlight> the 
                    WireMockServer after all tests are run.
                </p>
                <p>
                    Assembly fixtures do not serialize test classes. Because these examples change mappings on one shared WireMock
                    server, <Highlight>DisableTestParallelization = true</Highlight> deliberately preserves sequential execution.
                    Reset mappings before each test. To run in parallel instead, isolate servers or match requests using a
                    unique per-test value; a thread-safe server alone does not prevent conflicting mappings.
                </p>
            </li>
            <li>
                Extend <Highlight>BaseTest</Highlight> to expose the shared <Highlight>WireMockServer</Highlight>,
                while retaining a client and database scope owned by each test.

                <CodeSnippet CssClass="language-csharp">
using API.DbContexts;
using Microsoft.Extensions.DependencyInjection;
using WireMock.Server;

namespace FunctionalTest;

public abstract class BaseTest : IDisposable
{
    private readonly IServiceScope _scope;

    protected BaseTest(AppFixture fixture)
    {
        Factory = fixture;
        Client = fixture.CreateClient();
        _scope = fixture.Services.CreateScope();
        Database = _scope.ServiceProvider.GetRequiredService&lt;WeatherForecastDbContext&gt;();
        WeatherService.Reset();
    }

    protected AppFixture Factory { get; }
    protected HttpClient Client { get; }
    protected WeatherForecastDbContext Database { get; }
    protected WireMockServer WeatherService =&gt; Factory.WeatherService;

    public void Dispose()
    {
        Client.Dispose();
        _scope.Dispose();
    }
}
                </CodeSnippet>
            </li>
            <li>
                Now we need to <Highlight>setup response</Highlight> from the WireMock.NET server to be used in test. For that we need to add the 
                following setup code as shown below

                <CodeSnippet CssClass="language-csharp">
var expectedWeather = new ExternalWeatherForecast { Current_Weather = new CurrentWeather { Temperature = 18 } };
WeatherService
    .Given(Request.Create().WithPath("/v1/forecast").UsingGet())
    .RespondWith(Response.Create().WithStatusCode(HttpStatusCode.OK).WithBodyAsJson(expectedWeather));
                </CodeSnippet>

                

                <p>
                    The above <Highlight>setup</Highlight> is responsible to do request matching particular <Highlight>Path</Highlight> 
                    in WireMock.NET server and also the response to be returned using <Highlight>BodyAsJson</Highlight>. With this setup when we 
                    call External API in Functional Test WireMock kicks in and when the path matches, it will give the expected response to be 
                    <Highlight>asserted</Highlight> in test.
                </p>

                <p>
                    You can refer to the <Highlight>WireMock.NET</Highlight> 
                    <NavLink href="https://wiremock.org/docs/solutions/dotnet/" class="[ underline ]" target="_blank">documentation</NavLink> 
                    for more details on how to setup the request and response for various cases like timeouts, auth failure, etc.
                </p>
            </li>
            <li>
                Now we are left with our test. So lets add the test as shown below.

                <CodeSnippet CssClass="language-csharp">
using API;
using API.Services;
using System.Diagnostics.CodeAnalysis;
using System.Net;
using WireMock.RequestBuilders;
using WireMock.ResponseBuilders;
using Xunit;

namespace FunctionalTest;
[ExcludeFromCodeCoverage]
public class WeatherForecastControllerShouldTests(
    AppFixture fixture,
    ITestOutputHelper outputHelper) : BaseTest(fixture)
{
    [Fact]
    public async Task ReturnExpectedResponse_From_API()
    {
        var expectedWeather = new ExternalWeatherForecast { Current_Weather = new CurrentWeather { Temperature = 18 } };
        WeatherService
            .Given(Request.Create().WithPath("/v1/forecast").UsingGet())
            .RespondWith(Response.Create().WithStatusCode(HttpStatusCode.OK).WithBodyAsJson(expectedWeather));

        var result = await Client.GetJsonResultAsync&lt;WeatherForecast&gt;("/weatherforecast/fromapi", HttpStatusCode.OK, outputHelper);
        
        Assert.NotNull(result);
        Assert.Equal((int)expectedWeather.Current_Weather.Temperature, result.TemperatureC);
        Assert.Equal(DateOnly.FromDateTime(DateTime.Now), result.Date);
    }
}
                </CodeSnippet>

                

                <p>
                    In the above code if you notice, we are returning Temperature value as 18 from WireMockServer response and using it to assert in the test.
                </p>
            </li>
        </ol>

        

        <p>
            Thats it. We are done with setup. Now the tests will run in the following flow.
        </p>

        <ol>
            <li>Create the assembly's AppFixture.</li>
            <li>Start WireMock and PostgreSQL once.</li>
            <li>Run Program.cs.</li>
            <li>Service Registration.</li>
            <li>Overriding Configuration.</li>
            <li>Build Web Application.</li>
            <li>Apply migrations and seed data once.</li>
            <li>Create each test's client and database scope, then reset WireMock mappings.</li>
            <li>Test Code Execution.</li>
            <li>Dispose the shared application host and external services after all tests finish.</li>
        </ol>

        

