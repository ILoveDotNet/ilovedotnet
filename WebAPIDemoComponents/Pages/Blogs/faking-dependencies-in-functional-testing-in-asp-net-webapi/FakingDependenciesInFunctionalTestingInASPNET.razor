@page "/blogs/faking-dependencies-in-functional-testing-in-asp-net-webapi"
@using BaseComponents
@inherits BasePage

<Content FileName=@nameof(FakingDependenciesInFunctionalTestingInASPNET)>
    <ContentBody>
        <What>
            <p>
                In this article, let's learn about how to fake dependencies in <Highlight>Functional Test</Highlight> in 
                <Highlight>WebAPI</Highlight> in ASP.NET Core on <Highlight>.NET 11</Highlight>.
            </p>

            <p>
                <strong>Note:</strong> If you have not done so already, I recommend you read the article on
                <NavLink href="blogs/functional-testing-your-asp-net-webapi" Match="NavLinkMatch.All">Functional testing your ASP.NET WEB API</NavLink>.
            </p>

            <p>
                There are situations where we need to <Highlight>fake dependencies or replace services</Highlight> in our Functional Test. We'll learn 
                about where to place the <Highlight>boundary</Highlight> for integration tests and how this relates to the <Highlight>external 
                dependencies, such as a database, queues, etc</Highlight>. And we'll create a fake for a dependency at that defined boundary.
            </p>
        </What>

        <Why>
            <p>
                Rather than using services from our <Highlight>real cloud provider</Highlight> in this article, which would complicate the setup to 
                follow along, it's good enough to use our imagination. When working with cloud providers, it's common to use language-specific SDKs that they supply 
                and maintain to code against their managed services. The implementations just hold the data in memory to mimic a real service, and that's sufficient 
                for this scenario.
            </p>

            <p>
                The benefits of faking in functional tests include:
            </p>

            <ul>
                <li>Savings in <Highlight>cost</Highlight>.</li>
                <li>Faster <Highlight>time</Highlight> to complete the test.</li>
                <li><Highlight>Simple & Easy</Highlight> to setup.</li>
            </ul>

            <p>
                Therefore, lets fake these kind of dependencies.
            </p>
        </Why>

        <How>
            <p>
                Let's begin by creating a new test method named <Highlight CssClasses="[ break-all ]">GetWeatherForecastFromDatabase</Highlight>, and 
                we'll copy previous test to send the request and deserialize the response. So at this point, running the test results in a <Highlight>failure</Highlight>. 
                Before we complete this test and its implementation, let's review the architecture of the API. We're building a cloud-native web API, so let's 
                imagine that we're going to use some cloud services such as a managed database.
            </p>

            <CodeSnippet CssClass="language-csharp">
using API;
using System.Diagnostics.CodeAnalysis;
using System.Net;
using Xunit;

namespace FunctionalTest;
[ExcludeFromCodeCoverage]
public class WeatherForecastControllerShouldTests(
    AppFixture fixture,
    ITestOutputHelper outputHelper) : BaseTest(fixture)
{
    [Fact]
    public async Task ReturnExpectedResponse_From_Database()
    {
        var result = await Client.GetJsonResultAsync&lt;List&lt;WeatherForecast&gt;&gt;("/weatherforecast/fromdatabase", HttpStatusCode.OK, outputHelper);
        Assert.Equal("Freezing from database", Assert.Single(result).Summary);
    }
}
            </CodeSnippet>

            <figure>
                <img src="./image/blogs/webapi/faking-dependencies-in-functional-testing-in-asp-net-webapi/failing-test.png" alt="failing-test" class="[ w-full ]" />
            </figure>

            <p>
                We have <Highlight CssClasses="[ break-all ]">WeatherForecastDbContext</Highlight> class in our API project. This is configured with 
                cloud connection string and registed in <Highlight>Program.cs</Highlight>. We are going to inject this into our action method and read 
                the weather forecast data from database. I'm going to get into details of setting up <Highlight>DbContext</Highlight>. I'll cover this 
                in my <Highlight>EntityFramework</Highlight> Learning Path.
            </p>

            <figure>
                <caption>Endpoint to return values from Database</caption>
                <img src="./image/blogs/webapi/faking-dependencies-in-functional-testing-in-asp-net-webapi/from-database-endpoint.png" alt="from-database-endpoint" class="[ w-full ]" />
            </figure>

            <figure>
                <caption>Swagger output from Endpoint to return values from Database</caption>
                <img src="./image/blogs/webapi/faking-dependencies-in-functional-testing-in-asp-net-webapi/swagger-response.png" alt="swagger-response" class="[ w-full ]" />
            </figure>

            <h4>Faking Database</h4>

            <p id="functional-test-prerequisites">
                <strong>Version prerequisites:</strong> These fixture examples target <Highlight>.NET 11</Highlight>
                and require <Highlight>EF Core 9 or later</Highlight> for <Highlight>IDbContextOptionsConfiguration&lt;TContext&gt;</Highlight>.
                The linked sample predates this configuration, so upgrading xUnit alone is not enough.
                Set <Highlight>TargetFramework</Highlight> to <Highlight>net11.0</Highlight> in both the API and test projects.
                Before following this series, upgrade <Highlight>Microsoft.EntityFrameworkCore</Highlight> and
                <Highlight>Microsoft.EntityFrameworkCore.Tools</Highlight> in the API, plus
                <Highlight>Microsoft.EntityFrameworkCore.Sqlite</Highlight> and <Highlight>Microsoft.Data.Sqlite</Highlight>
                in the test project, to compatible versions in the same 9-or-later major release.
                Upgrade <Highlight>Npgsql.EntityFrameworkCore.PostgreSQL</Highlight> in both projects to a provider version
                explicitly supporting the selected EF Core release. EF Core package versions are separate from the .NET target framework;
                do not mix providers and EF Core packages from incompatible major releases.
                Restore both projects together and resolve any version conflicts before running the tests.
            </p>

            <p>
                These examples use <Highlight>xUnit.net v3</Highlight> (the <Highlight>xunit.v3</Highlight> package).
                Replace the v2 <Highlight>xunit</Highlight> package and change <Highlight>using Xunit.Abstractions;</Highlight>
                to <Highlight>using Xunit;</Highlight> in tests and HTTP helpers. The v3 <Highlight>IAsyncLifetime</Highlight>
                methods return <Highlight>ValueTask</Highlight>, not <Highlight>Task</Highlight>.
                Assembly fixtures are not available in xUnit.net v2. We extend the introductory article's
                <NavLink href="https://xunit.net/docs/shared-context#assembly-fixtures" target="_blank">assembly fixture</NavLink>
                to manage the database lifetime as well as the shared application host.
            </p>

            <p>
                xUnit.net v3 test projects must also be executables. Add the following property to
                <Highlight>FunctionalTest.csproj</Highlight> (the linked v2 project defaults to a library):
            </p>

            <CodeSnippet CssClass="language-xml">
&lt;PropertyGroup&gt;
  &lt;OutputType&gt;Exe&lt;/OutputType&gt;
&lt;/PropertyGroup&gt;
            </CodeSnippet>

            <p>
                For Visual Studio or VSTest discovery, upgrade <Highlight>xunit.runner.visualstudio</Highlight>
                from the sample's 2.8.1 to <Highlight>3.0.0 or later</Highlight>; the v2 adapter cannot discover v3 tests.
                Keep <Highlight>Microsoft.NET.Test.Sdk</Highlight> for VSTest, and follow the
                <NavLink href="https://xunit.net/docs/getting-started/v3/migration" target="_blank">xUnit v3 migration guide</NavLink>
                for the runner you use.
            </p>

            <p>
                In this example in our API, we are going to use <Highlight>EntityFramework</Highlight> to connect to cloud database. We can fake the 
                database by using an <Highlight>in-memory sqlite</Highlight> database provider to run our tests. Reason to use in memory sqlite 
                provider than in memory database is to make sure relation constraints are working as expected.
            </p>

            <ol>
                <li>
                    <p>
                        Add reference to <Highlight CssClasses="[ break-all ]">Microsoft.EntityFrameworkCore.Sqlite</Highlight> and 
                        <Highlight CssClasses="[ break-all ]">Microsoft.Data.Sqlite</Highlight> Nuget Package in 
                        <Highlight CssClasses="[ break-all ]">FunctionalTest.csproj</Highlight>.
                    </p>
                </li>
                <li>
                    <p>
                        Add <Highlight>static DatabaseHelper.cs</Highlight> helper class to <Highlight>Initialize</Highlight> and 
                        <Highlight>Reset</Highlight> Data for used in tests.
                    </p>

                    <CodeSnippet CssClass="language-csharp">
using API;
using API.DbContexts;

namespace FunctionalTest;

public static class DatabaseHelper
{
    public static async Task InitializeDbForTestsAsync(WeatherForecastDbContext db)
    {
        await db.WeatherForecasts.AddAsync(
            new WeatherForecast
            {
                Id = 1,
                Date = DateOnly.FromDateTime(DateTime.Now.AddDays(1)),
                TemperatureC = 1,
                Summary = "Freezing from database"
            });
        await db.SaveChangesAsync();
    }

    public static async Task ResetDbForTestsAsync(WeatherForecastDbContext db)
    {
        db.WeatherForecasts.RemoveRange(db.WeatherForecasts);
        await db.SaveChangesAsync();
    }
}
                    </CodeSnippet>
                </li>
                <li>
                    <p>
                        Combine the database lifetime and <Highlight>WebApplicationFactory</Highlight> in <Highlight>AppFixture</Highlight>.
                        Register it with <Highlight>[assembly: AssemblyFixture(typeof(AppFixture))]</Highlight> before the namespace.
                        xUnit initializes the database once before any tests run and disposes the host and database after all tests finish.
                    </p>

                    <CodeSnippet CssClass="language-csharp">
using API.DbContexts;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.AspNetCore.TestHost;
using Microsoft.Data.Sqlite;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Infrastructure;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Xunit;

[assembly: AssemblyFixture(typeof(FunctionalTest.AppFixture))]
namespace FunctionalTest;
public class AppFixture : WebApplicationFactory&lt;Program&gt;, IAsyncLifetime
{
    private readonly SqliteConnection _connection = new(
        $"Data Source={Guid.NewGuid():N};Mode=Memory;Cache=Shared");

    protected override void ConfigureWebHost(IWebHostBuilder builder)
    {
        builder.UseEnvironment("Test");

        builder.ConfigureTestServices(services =&gt;
        {
            services.RemoveAll&lt;WeatherForecastDbContext&gt;();
            services.RemoveAll&lt;DbContextOptions&lt;WeatherForecastDbContext&gt;&gt;();
            services.RemoveAll&lt;IDbContextOptionsConfiguration&lt;WeatherForecastDbContext&gt;&gt;();

            services.AddDbContext&lt;WeatherForecastDbContext&gt;(opts =&gt;
                opts.UseSqlite(_connection.ConnectionString));
        });
    }

    public async ValueTask InitializeAsync()
    {
        await _connection.OpenAsync();
        await using var scope = Services.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService&lt;WeatherForecastDbContext&gt;();
        await db.Database.EnsureCreatedAsync();
        await DatabaseHelper.InitializeDbForTestsAsync(db);
    }

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        await _connection.DisposeAsync();
    }
}
                    </CodeSnippet>
                    <p>
                        The open keeper connection preserves the named in-memory database while each request uses its own connection.
                        <Highlight>ConfigureTestServices</Highlight> replaces both the context and its original provider configuration
                        after the application's registrations. Remove the old <Highlight>SharedFixture</Highlight>,
                        <Highlight>CustomWebApiFactory</Highlight>, and <Highlight>FunctionalTestCollection</Highlight> classes.
                    </p>
                </li>
            </ol>            <p>
                Thats it. We are done with setup. Now the tests will run in the following flow.
            </p>

            <ol>
                <li>Create the assembly's AppFixture.</li>
                <li>Open the SQLite keeper connection.</li>
                <li>Run Program.cs.</li>
                <li>Service Registration.</li>
                <li>Override service registration with ConfigureTestServices.</li>
                <li>Build Web Application.</li>
                <li>Create and seed the database once.</li>
                <li>Create a test instance with the shared AppFixture.</li>
                <li>Create HTTP Client.</li>
                <li>Test Code Execution.</li>
            </ol>

            <p>
                Give each test its own <Highlight>HttpClient</Highlight> and DI scope in <Highlight>BaseTest</Highlight>.
                Never share a <Highlight>DbContext</Highlight> between tests: it is not thread-safe.
                Dispose test-owned resources, but leave disposal of the shared <Highlight>AppFixture</Highlight> to xUnit.
            </p>

            <CodeSnippet CssClass="language-csharp">
using API.DbContexts;
using Microsoft.Extensions.DependencyInjection;

namespace FunctionalTest;

public abstract class BaseTest : IDisposable
{
    private readonly IServiceScope _scope;

    protected BaseTest(AppFixture fixture)
    {
        Factory = fixture;
        Client = fixture.CreateClient();
        _scope = fixture.Services.CreateScope();
        Database = _scope.ServiceProvider.GetRequiredService&lt;WeatherForecastDbContext&gt;();
    }

    protected AppFixture Factory { get; }
    protected HttpClient Client { get; }
    protected WeatherForecastDbContext Database { get; }

    public void Dispose()
    {
        Client.Dispose();
        _scope.Dispose();
    }
}
            </CodeSnippet>

            <p>
                Inject <Highlight>AppFixture</Highlight> directly into the test constructor. No <Highlight>[Collection]</Highlight>
                or <Highlight>IClassFixture</Highlight> is needed. Assembly fixtures do not serialize test classes:
                these examples only read shared seed data. Tests that change data need isolated records or databases;
                do not reset shared data while other tests are using it.
            </p>

            <CodeSnippet CssClass="language-csharp">
using API;
using Microsoft.EntityFrameworkCore;
using System.Diagnostics.CodeAnalysis;
using System.Net;
using Xunit;

namespace FunctionalTest;
[ExcludeFromCodeCoverage]
public class WeatherForecastControllerShouldTests(
    AppFixture fixture,
    ITestOutputHelper outputHelper) : BaseTest(fixture)
{
    [Fact]
    public async Task ReturnExpectedResponse_From_Database()
    {
        var expectedWeatherForecast = await Database.WeatherForecasts.FirstAsync();

        var result = await Client.GetJsonResultAsync&lt;List&lt;WeatherForecast&gt;&gt;("/weatherforecast/fromdatabase", HttpStatusCode.OK, outputHelper);
        Assert.Equivalent(expectedWeatherForecast, Assert.Single(result));
    }
}
            </CodeSnippet>

