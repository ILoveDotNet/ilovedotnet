@inject NavigationManager NavigationManager

<nav aria-label="On this page">
    <ol class="[ flex flex-col py-1 text-sm ]">
        <li><a href="@($"{ArticleUrl}#what")" class="[ flex min-h-11 items-center rounded-md px-2 underline focus-visible:outline-2 focus-visible:outline-indigo-500 ]">What you'll learn</a></li>
        <li><a href="@($"{ArticleUrl}#why")" class="[ flex min-h-11 items-center rounded-md px-2 underline focus-visible:outline-2 focus-visible:outline-indigo-500 ]">Why it matters</a></li>
        <li><a href="@($"{ArticleUrl}#how")" class="[ flex min-h-11 items-center rounded-md px-2 underline focus-visible:outline-2 focus-visible:outline-indigo-500 ]">Implementation</a></li>
        <li><a href="@($"{ArticleUrl}#summary")" class="[ flex min-h-11 items-center rounded-md px-2 underline focus-visible:outline-2 focus-visible:outline-indigo-500 ]">Summary</a></li>
    </ol>
</nav>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = default!;
    private string ArticleUrl => $"/blogs/{Slug}/{new Uri(NavigationManager.Uri).Query}";
}
