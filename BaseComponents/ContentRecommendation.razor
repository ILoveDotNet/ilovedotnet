@inject AdSpaceService AdSpaceService
@inject TableOfContents TableOfContents

<section aria-labelledby="related-articles" class="[ min-w-0 space-y-4 ]">
    <section aria-label="Advertisement" class="[ space-y-2 lg:sticky lg:top-14 ]">
        <p class="[ text-xs text-stone-600 dark:text-stone-300 ]">Advertisements</p>
        <GoogleAdSense Type="GoogleAdSenseAdType.InFeed" Format="GoogleAdSenseAdFormat.Fluid" LayoutKey="-7m+de+1z+n+3" Slot="2741354693" />
    </section>
    <h2 id="related-articles" class="[ text-xl font-semibold ]">Related articles</h2>
    @if (relatedContents.Count == 0)
    {
        <p class="[ text-sm text-stone-600 dark:text-stone-300 ]">More tutorials are on the way. Explore the other learning paths for now.</p>
        <a href="/learningpath/" class="[ inline-flex min-h-11 items-center underline ]">Browse learning paths →</a>
    }
    <div class="[ min-w-0 space-y-4 ]" aria-live="polite">
        @foreach (var (content, index) in relatedContents.Take(take).Select((content, index) => (content, index)))
        {
            @if (AdSpaceService.CanDisplayAd(index + 1))
            {
                <GoogleAdSense Type="GoogleAdSenseAdType.InFeed" Format="GoogleAdSenseAdFormat.Fluid" LayoutKey="-7m+de+1z+n+3" Slot="2741354693" />
            }
            <div @key="content.Slug" class="[ min-w-0 border-b border-stone-200 pb-4 dark:border-stone-700 ]">
                <Thumbnail PosterUrl="@content.ThumbnailUrl"
                           ContentUrl="@content.ContentUrl"
                           Title="@content.Title"
                           AltText="@($"{content.Title} tutorial thumbnail")"
                           IconUrl="@content.IconUrl"
                           IconAlt="@content.Channel"
                           Channel="@content.Channel"
                           HeadingLevel="3"
                           CreatedOn="@content.ModifiedOn"
                           Author="@content.Author"
                           Sidebar="true" />
            </div>
        }
    </div>
    @if (take < relatedContents.Count)
    {
        <button type="button" @onclick="ShowMoreContents" class="[ min-h-11 rounded-lg border border-stone-300 px-3 py-2 underline focus-visible:outline-2 focus-visible:outline-indigo-500 dark:border-stone-600 ]">Show more related articles</button>
    }
    <section aria-label="About the author" class="[ flex items-center gap-3 rounded-xl border border-stone-200 p-4 dark:border-stone-700 ]">
        <img src="/image/authors/abdul rahman.webp" alt="Abdul Rahman" loading="lazy" width="393" height="393" class="[ h-14 w-14 shrink-0 rounded-full object-cover ]" />
        <div class="[ min-w-0 space-y-1 text-sm ]">
            <p class="[ font-semibold ]">@Metadata.Author</p>
            <p class="[ text-stone-600 dark:text-stone-300 ]">Microsoft MVP</p>
            <a href="/authors/abdul-rahman/" class="[ inline-flex min-h-11 items-center underline ]">About the author →</a>
        </div>
    </section>
    <GoogleAdSense Type="GoogleAdSenseAdType.InFeed" Format="GoogleAdSenseAdFormat.Fluid" LayoutKey="-7m+de+1z+n+3" Slot="2741354693" />
</section>

@code {
    private const int PageSize = 6;
    private string? slug;
    private int take = PageSize;
    private IReadOnlyList<ContentMetaData> relatedContents = [];

    [Parameter, EditorRequired] public ContentMetaData Metadata { get; set; } = default!;

    protected override void OnParametersSet()
    {
        if (slug != Metadata.Slug)
        {
            slug = Metadata.Slug;
            take = PageSize;
            relatedContents = TableOfContents.GetRelatedContents(slug, int.MaxValue);
        }
    }

    private void ShowMoreContents() => take += PageSize;
}
