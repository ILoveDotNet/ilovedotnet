@inherits CodeSnippetBase

<div class="[ not-prose relative my-6 min-w-0 rounded-xl border border-stone-300 dark:border-stone-700 ]">
    <div class="[ flex min-w-0 flex-wrap items-center justify-between gap-2 rounded-t-xl bg-stone-100 px-4 py-2 text-sm dark:bg-stone-800 ]">
        <span class="[ font-semibold ]">@Language</span>
        <button type="button" @onclick="CopyAsync" disabled="@(module is null)" aria-label="@($"Copy {Language} code")" class="[ min-h-11 rounded-md border border-stone-300 px-3 py-2 focus-visible:outline-2 focus-visible:outline-indigo-500 disabled:opacity-50 dark:border-stone-600 ]">@(CopyStatus == "Copied to clipboard." ? "Copied" : "Copy")</button>
    </div>
    <p role="status" class="@(CopyFailed ? "[ px-4 py-2 text-sm text-red-700 dark:text-red-300 ]" : "sr-only")">@CopyStatus</p>
    <pre tabindex="0" role="region" aria-label="@($"{Language} code")" class="[ relative m-0 max-w-full overflow-x-auto rounded-b-xl bg-[#333] p-4 text-sm text-[#ddd] focus-visible:outline-2 focus-visible:outline-indigo-500 [&_code]:overflow-visible [&_code]:p-0 ]"><code id="@Id" class="@CssClass">@ChildContent</code></pre>
</div>