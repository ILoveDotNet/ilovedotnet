<header class="[ min-w-0 space-y-4 ]">
    <a href="@($"/channels/{Metadata.Channel.ToLowerInvariant().ApplyHyphen()}/")" class="[ inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-indigo-700 underline dark:text-indigo-300 ]">
        <img src="@Metadata.IconUrl" alt="@($"{Metadata.Channel} channel icon")" height="32" width="32" class="[ h-8 w-8 rounded-full ]" />
        @Metadata.Channel · @PublishedCount published articles
    </a>
    <h1 id="article-title" class="[ break-words text-3xl font-bold leading-tight dark:text-white sm:text-4xl ]">@Metadata.Title</h1>
    <p class="[ max-w-[75ch] text-lg leading-relaxed text-stone-600 dark:text-stone-300 ]">@Metadata.Description</p>
    <div class="[ flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-stone-600 dark:text-stone-300 ]">
        <a href="/authors/abdul-rahman/" class="[ inline-flex min-h-11 items-center underline ]">@Metadata.Author</a>
        <time datetime="@Metadata.ModifiedOn.ToString("yyyy-MM-dd")">Updated @Metadata.ModifiedOn.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</time>
        <a href="@($"https://github.com/ILoveDotNet/ilovedotnet/blob/main/{Metadata.Channel.Replace(" ", string.Empty)}DemoComponents/Pages/Blogs/{FileName}.razor")" target="_blank" rel="noopener noreferrer" class="[ inline-flex min-h-11 items-center underline ]">Edit on GitHub <span class="sr-only">(opens in a new tab)</span></a>
    </div>
    @if (!string.IsNullOrWhiteSpace(Metadata.VideoUrl))
    {
        <iframe src="@Metadata.VideoUrl" title="@($"{Metadata.Title} video")"
                class="[ aspect-video w-full rounded-xl border-0 ]"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen>
        </iframe>
    }
    else
    {
        <figure class="[ aspect-video overflow-hidden rounded-xl ]">
            <img src="@Metadata.PosterUrl.ToLowerInvariant()" alt="@Metadata.Title" class="[ h-full w-full object-contain ]" fetchpriority="high" width="1265" height="827" />
        </figure>
    }
</header>

@code {
    [Parameter, EditorRequired] public ContentMetaData Metadata { get; set; } = default!;
    [Parameter, EditorRequired] public string FileName { get; set; } = default!;
    [Parameter, EditorRequired] public int PublishedCount { get; set; }
}
