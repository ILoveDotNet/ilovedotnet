@inherits DemoSnippetBase

@if(Environment.IsPrerendering())
{
    <section class="[ flex items-center justify-center ] [ min-h-[300px] ] [ dark:bg-gray-100 dark:text-black ] [ bg-stone-900 text-white ]">
        Live demo: @Title — interactive controls are available when the page loads.
    </section>
}
else
{
    <section aria-label="@($"Live demo: {Title}")" class="[ not-prose my-6 min-w-0 rounded-xl border border-indigo-200 dark:border-indigo-900 ]">
        <h4 class="[ flex items-center gap-2 rounded-t-xl bg-indigo-50 p-4 font-semibold text-indigo-900 dark:bg-indigo-950 dark:text-indigo-200 ]">
            <svg xmlns="http://www.w3.org/2000/svg" class="[ icon icon-tabler icon-tabler-caret-right ] [ text-lime-700 ] [ fill-lime-500 ]" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M18 15l-6 -6l-6 6h12" transform="rotate(90 12 12)"></path>
            </svg> Live demo · @Title
        </h4>
        <div tabindex="0" role="region" aria-label="@($"{Title} interactive example")" class="[ relative min-w-0 overflow-x-auto rounded-b-xl bg-white p-4 focus-visible:outline-2 focus-visible:outline-indigo-500 dark:bg-stone-800 ]">
            @ChildContent
        </div>
    </section>
}