<h3 id="why">Why it matters</h3>

@ChildContent

@if (ArticleAds is not null)
{
    <div id="@adBreakId" data-article-ad-break>
        @if (ArticleAds.MidArticleId == adBreakId)
        {
            <ArticleAd Position="ArticleAdPosition.MidArticle" />
        }
    </div>
}

@code 
{
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [CascadingParameter] public ArticleAdContext? ArticleAds { get; set; }

    private readonly string adBreakId = $"article-ad-break-{Guid.NewGuid():N}";
}