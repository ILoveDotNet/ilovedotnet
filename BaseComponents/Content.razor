@inject SlugService SlugService
@inject TableOfContents TableOfContents
@inject IConfiguration Configuration
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject Microsoft.Extensions.Logging.ILogger<Content> Logger
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable

<ContentHead Metadata="@contentMetaData" />

<section class="[ mx-auto grid w-full min-w-0 max-w-7xl gap-8 p-4 md:p-6 xl:grid-cols-[minmax(0,1fr)_18rem] ]">
    <article class="[ min-w-0 space-y-6 ]" aria-labelledby="article-title">
        <Breadcrumbs CurrentTitle="@contentMetaData.Title"
                     CurrentUrl="@($"/{contentMetaData.ContentUrl.Trim('/')}/")"
                     ParentTitle="@contentMetaData.Channel"
                     ParentUrl="@ChannelUrl" />
        <ContentHeader Metadata="@contentMetaData" FileName="@FileName" PublishedCount="@channelContents.Count" PathPosition="@pathPosition" ImplementationId="@ImplementationId" />
        @if (Introduction is not null)
        {
            <section aria-label="Before you begin" class="[ min-w-0 space-y-3 border-y border-stone-200 py-5 leading-relaxed [overflow-wrap:anywhere] dark:border-stone-700 [&_p]:max-w-[75ch] [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5 ]">
                @Introduction
            </section>
        }
        <details class="[ rounded-xl border border-indigo-200 bg-indigo-50 p-4 dark:border-indigo-900 dark:bg-indigo-950 xl:hidden ]">
            <summary class="[ min-h-11 cursor-pointer content-center font-semibold ]">On this page</summary>
            <ContentNavigation Slug="@contentMetaData.Slug" Headings="@headings" DetailedContentsUnavailable="@outlineFailed" />
        </details>
        <section @ref="articleBody" class="[ article-body prose max-w-none min-w-0 [overflow-wrap:anywhere] dark:prose-invert [&_p]:max-w-[75ch] [&_ul]:max-w-[75ch] [&_ol]:max-w-[75ch] ]" aria-label="Article body">
            <CascadingValue Value="@articleAds">
                @ContentBody
            </CascadingValue>
        </section>
        <ArticleAd Position="ArticleAdPosition.EndOfArticle" />
        <footer class="[ min-w-0 space-y-6 border-t border-stone-200 pt-6 dark:border-stone-700 ]">
            <nav aria-label="Continue this learning path" class="[ min-w-0 space-y-4 ]">
                <h2 class="[ text-2xl font-bold ]">Continue this learning path</h2>
                <p class="[ text-sm text-stone-600 dark:text-stone-300 ]">Explore @contentMetaData.Channel in the suggested order, or choose the tutorial you need.</p>
                @if (next is not null)
                {
                    <a href="@($"/{next.ContentUrl.Trim('/')}/")" rel="next" class="[ group flex min-w-0 flex-col gap-2 rounded-xl bg-indigo-950 p-5 text-white no-underline sm:p-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]">
                        <span class="[ text-sm font-semibold text-indigo-200 ]">Next tutorial →</span>
                        <span class="[ break-words text-lg font-bold group-hover:underline sm:text-xl ]">@next.Title</span>
                    </a>
                }
                <div class="[ flex flex-wrap items-center gap-x-6 gap-y-1 ]">
                    @if (previous is not null)
                    {
                        <a href="@($"/{previous.ContentUrl.Trim('/')}/")" rel="prev" class="[ inline-flex min-h-11 min-w-0 items-center break-words font-semibold text-indigo-700 underline underline-offset-4 dark:text-indigo-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]">← Previous tutorial: @previous.Title</a>
                    }
                    <a href="@ChannelUrl" class="[ inline-flex min-h-11 items-center font-semibold text-indigo-700 underline underline-offset-4 dark:text-indigo-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]">View all @contentMetaData.Channel tutorials →</a>
                </div>
            </nav>
            <section aria-labelledby="article-community-title" class="[ min-w-0 rounded-xl bg-amber-100 p-5 text-amber-950 sm:p-6 ]">
                <h2 id="article-community-title" class="[ text-xl font-bold ]">Keep learning together</h2>
                <p class="[ mt-2 max-w-2xl leading-relaxed ]">Get practical .NET tutorials and updates on WhatsApp, or connect with Abdul on LinkedIn to share ideas and ask questions.</p>
                <div class="[ mt-3 flex flex-wrap items-center gap-x-6 gap-y-1 ]">
                    <a href="https://whatsapp.com/channel/0029VaAGMV2LtOj5S5MHd23h" target="_blank" rel="noopener noreferrer"
                       class="[ inline-flex min-h-11 items-center font-bold text-amber-950 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-950 ]">
                        Join the WhatsApp channel <span class="sr-only">(opens in a new tab)</span>
                    </a>
                    <a href="https://www.linkedin.com/in/thebhai" target="_blank" rel="noopener noreferrer"
                       class="[ inline-flex min-h-11 items-center font-bold text-amber-950 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-950 ]">
                        Follow or message Abdul on LinkedIn <span class="sr-only">(opens in a new tab)</span>
                    </a>
                </div>
            </section>
            <section aria-label="Share and support" class="[ space-y-3 ]">
                <h2 class="[ text-lg font-semibold ]">Share this article</h2>
                <SocialShare Title="@contentMetaData.Title" Url="@($"{Configuration["baseUrl"]}{contentMetaData.ContentUrl}")" />
                <div class="[ flex flex-wrap items-center gap-x-6 ]">
                    <a href="https://github.com/sponsors/fingers10" target="_blank" rel="noopener noreferrer" class="[ inline-flex min-h-11 items-center underline ]">Support the project <span class="sr-only">(opens in a new tab)</span></a>
                    <a href="/sponsor/" class="[ inline-flex min-h-11 items-center underline ]">Sponsorship enquiries</a>
                </div>
            </section>
            <ul aria-label="Article topics" class="[ flex min-w-0 flex-wrap gap-2 text-sm ]">
                <li><a href="@ChannelUrl" class="[ inline-flex min-h-11 items-center rounded-lg bg-indigo-50 px-3 py-2 text-indigo-800 underline dark:bg-indigo-950 dark:text-indigo-200 ]">@contentMetaData.Channel</a></li>
                @foreach (var keyword in contentMetaData.Keywords)
                {
                    <li class="[ min-w-0 break-words rounded-lg bg-stone-200 px-3 py-2 dark:bg-stone-800 ]">@keyword</li>
                }
            </ul>
        </footer>
    </article>
    <aside aria-label="Article resources" class="[ flex min-w-0 flex-col gap-6 ]">
        <div class="[ hidden rounded-xl border border-indigo-200 bg-indigo-50 p-3 dark:border-indigo-900 dark:bg-indigo-950 xl:block ]">
            <h2 class="[ font-semibold ]">On this page</h2>
            <ContentNavigation Slug="@contentMetaData.Slug" Headings="@headings" DetailedContentsUnavailable="@outlineFailed" />
        </div>
        <ArticleAd Position="ArticleAdPosition.Sidebar" />
        <ContentRecommendation @key="contentMetaData.Slug" Metadata="@contentMetaData" />
        <div class="[ article-sponsor-space hidden min-h-0 flex-1 flex-col justify-end xl:flex ]">
            <section aria-label="Sponsorship enquiries" class="[ article-sponsor-panel space-y-3 rounded-xl border border-stone-300 bg-white p-4 dark:border-stone-700 dark:bg-stone-800 ]">
                <h2 class="[ text-lg font-semibold text-stone-900 dark:text-white ]">Sponsor I ❤️ .NET</h2>
                <p class="[ text-sm leading-relaxed text-stone-600 dark:text-stone-300 ]">Interested in promoting your developer tool or service here?</p>
                <a href="https://www.linkedin.com/in/thebhai" target="_blank" rel="noopener noreferrer"
                   class="[ inline-flex min-h-11 items-center rounded-lg bg-indigo-700 px-3 py-2 text-sm font-semibold text-white no-underline hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]">
                    Discuss on LinkedIn <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a href="/sponsor/" class="[ inline-flex min-h-11 items-center text-sm font-semibold text-indigo-700 underline dark:text-indigo-300 ]">Sponsorship details</a>
            </section>
        </div>
    </aside>
</section>

@code {
    private ContentMetaData contentMetaData = default!;
    private List<ContentMetaData> channelContents = [];
    private ContentMetaData? previous;
    private ContentMetaData? next;
    private int? pathPosition;
    private ElementReference articleBody;
    private IJSObjectReference? outlineModule;
    private IReadOnlyList<ArticleHeading> headings = [];
    private string? outlinedSlug;
    private bool outlineFailed;
    private bool disposed;
    private bool restoreFragmentPending;
    private ArticleAdContext articleAds = new(null);
    private string ChannelUrl => $"/channels/{contentMetaData.Channel.ToLowerInvariant().ApplyHyphen()}/";

    [Parameter, EditorRequired] public RenderFragment ContentBody { get; set; } = default!;
    [Parameter, EditorRequired] public string FileName { get; set; } = default!;
    [Parameter] public RenderFragment? Introduction { get; set; }
    [Parameter] public string ImplementationId { get; set; } = "how";

    protected override void OnParametersSet()
    {
        contentMetaData = TableOfContents.GetContentBySlug(SlugService.GetSlug());
        channelContents = TableOfContents.Contents
            .Where(content => content.Channel.Equals(contentMetaData.Channel, StringComparison.OrdinalIgnoreCase))
            .OrderBy(content => content.Order).ToList();
        var index = channelContents.FindIndex(content => content.Slug == contentMetaData.Slug);
        previous = index > 0 ? channelContents[index - 1] : null;
        next = index >= 0 && index + 1 < channelContents.Count ? channelContents[index + 1] : null;
        pathPosition = index >= 0 && channelContents.Count > 1 ? index + 1 : null;
        if (outlinedSlug != contentMetaData.Slug)
        {
            headings = [];
            outlineFailed = false;
            articleAds = new(null);
            restoreFragmentPending = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoreFragmentPending && outlineModule is not null)
        {
            restoreFragmentPending = false;
            try
            {
                await outlineModule.InvokeVoidAsync("restoreFragment", articleBody);
            }
            catch (JSDisconnectedException) when (disposed)
            {
                return;
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "Unable to open the requested section for article {Slug}", contentMetaData.Slug);
            }
        }

        if (outlinedSlug == contentMetaData.Slug)
        {
            return;
        }

        var slug = contentMetaData.Slug;
        outlinedSlug = slug;
        try
        {
            var module = outlineModule ?? await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./article.js");
            if (disposed)
            {
                await module.DisposeAsync();
                return;
            }

            outlineModule = module;
            var entries = await module.InvokeAsync<ArticleHeading[]>("getHeadings", articleBody);
            string? midArticleId = null;
            try
            {
                midArticleId = await module.InvokeAsync<string?>("getMidArticleAdId", articleBody);
            }
            catch (JSDisconnectedException) when (disposed)
            {
                return;
            }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "Unable to select a mid-article advertisement for {Slug}", slug);
            }
            if (disposed || slug != contentMetaData.Slug)
            {
                return;
            }

            headings = entries;
            articleAds = new(midArticleId);
            restoreFragmentPending = true;
        }
        catch (JSDisconnectedException) when (disposed)
        {
            return;
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Unable to load detailed contents for article {Slug}", slug);
            if (disposed || slug != contentMetaData.Slug)
            {
                return;
            }

            outlineFailed = true;
            headings = [];
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (outlineModule is not null)
        {
            try
            {
                await outlineModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The native web view or browser circuit has already closed.
            }
        }
    }
}
