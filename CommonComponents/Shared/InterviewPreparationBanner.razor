<section aria-labelledby="interview-preparation-title" class="[ relative isolate overflow-hidden rounded-2xl ] [ bg-linear-to-br from-slate-950 via-indigo-950 to-purple-900 ] [ text-white ]">
    <div aria-hidden="true" class="[ pointer-events-none absolute -right-16 -top-24 -z-10 h-72 w-72 rounded-full bg-violet-500/20 blur-3xl ]"></div>
    <div class="[ flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between ] [ p-6 md:p-8 xl:p-10 ]">
        <div class="[ flex min-w-0 items-start gap-5 ]">
            <div aria-hidden="true" class="[ hidden shrink-0 items-center justify-center md:flex ] [ h-16 w-16 rounded-2xl border border-white/20 bg-white/10 text-violet-200 ]">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="16" rx="3"></rect>
                    <path d="m9 9-3 3 3 3m6-6 3 3-3 3m-2-7-2 10"></path>
                </svg>
            </div>
            <div class="[ flex min-w-0 flex-col gap-3 ]">
                <p class="[ text-xs font-bold uppercase tracking-widest text-violet-200 ]">Interview prep</p>
                <h2 id="interview-preparation-title" class="[ text-2xl md:text-3xl font-bold leading-tight text-white ]">@Heading</h2>
                <p class="[ max-w-2xl text-base leading-relaxed text-slate-200 ]">@Description</p>
                <ul class="[ flex flex-wrap gap-x-5 gap-y-2 ] [ text-sm text-slate-200 ]" role="list">
                    <li class="[ flex items-center gap-2 ]">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="[ shrink-0 text-violet-300 ]" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 12 4 4L19 6"></path>
                        </svg>
                        C# &amp; .NET Q&amp;A
                    </li>
                    <li class="[ flex items-center gap-2 ]">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="[ shrink-0 text-violet-300 ]" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 12 4 4L19 6"></path>
                        </svg>
                        System design
                    </li>
                    <li class="[ flex items-center gap-2 ]">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="[ shrink-0 text-violet-300 ]" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 12 4 4L19 6"></path>
                        </svg>
                        14-point checklist
                    </li>
                </ul>
            </div>
        </div>
        <a href="interview/" aria-label="Start preparing for your C# and .NET interview" class="[ inline-flex shrink-0 items-center justify-center gap-3 md:self-start lg:self-center ] [ rounded-xl bg-white px-6 py-3 text-base font-bold text-indigo-950 no-underline ] [ hover:bg-violet-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white ]">
            Start preparing
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
        </a>
    </div>
</section>

@code {
    [Parameter]
    public string Heading { get; set; } = "Your next .NET role starts here.";

    [Parameter]
    public string Description { get; set; } = "Build confidence with C# and .NET interview questions, system design exercises, and a practical readiness checklist.";
}
