<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Blazor-Analytics" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <!-- <PackageReference Include="SmartComponents.LocalEmbeddings" Version="0.1.0-preview10148" /> -->
	  <PackageReference Include="Toolbelt.Blazor.HotKeys2" />
	  <PackageReference Include="Toolbelt.Blazor.HeadElement" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaseComponents\BaseComponents.csproj" />
    <ProjectReference Include="..\SharedModels\SharedModels.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ChatCorpusCutoff Condition="'$(ChatCorpusCutoff)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</ChatCorpusCutoff>
    <TransformersBundleDirectory>$(MSBuildThisFileDirectory)..\TransformersBundle\</TransformersBundleDirectory>
    <TransformersBundleOutput>wwwroot\lib\transformers\transformers.min.js</TransformersBundleOutput>
    <ThirdPartyNoticesSource>$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.txt</ThirdPartyNoticesSource>
    <ThirdPartyNoticesOutput>wwwroot\THIRD-PARTY-NOTICES.txt</ThirdPartyNoticesOutput>
  </PropertyGroup>

  <ItemGroup>
    <ChatBundleInput Include="$(MSBuildThisFileDirectory)..\ChatBundle\src\**\*" />
    <ChatBundleInput Include="$(MSBuildThisFileDirectory)..\ChatBundle\package.json;$(MSBuildThisFileDirectory)..\ChatBundle\package-lock.json" />
    <TransformersBundleInput Include="$(TransformersBundleDirectory)src\**\*" />
    <TransformersBundleInput Include="$(TransformersBundleDirectory)package.json" />
    <TransformersBundleInput Include="$(TransformersBundleDirectory)package-lock.json" />
    <TransformersBundleInput Include="$(ThirdPartyNoticesSource)" />
  </ItemGroup>

  <Target Name="BuildChatBundle" BeforeTargets="ResolveProjectStaticWebAssets"
          Inputs="@(ChatBundleInput)" Outputs="wwwroot\lib\webllm\webllm.js">
    <Exec Command="npm ci --include=dev --ignore-scripts" WorkingDirectory="$(MSBuildThisFileDirectory)..\ChatBundle"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\ChatBundle\node_modules\@mlc-ai\web-llm') OR !Exists('$(MSBuildThisFileDirectory)..\ChatBundle\node_modules\esbuild')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\ChatBundle" />
    <MakeDir Directories="wwwroot\lib\webllm" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\ChatBundle\dist\webllm.js" DestinationFiles="wwwroot\lib\webllm\webllm.js" />
    <ItemGroup>
      <Content Remove="wwwroot\lib\webllm\webllm.js" />
      <Content Include="wwwroot\lib\webllm\webllm.js" />
    </ItemGroup>
  </Target>

  <Target Name="BuildTransformersBundle" BeforeTargets="ResolveProjectStaticWebAssets" Inputs="@(TransformersBundleInput)" Outputs="$(TransformersBundleOutput);$(ThirdPartyNoticesOutput)">
    <Exec Command="npm ci --include=dev" WorkingDirectory="$(TransformersBundleDirectory)" Condition="!Exists('$(TransformersBundleDirectory)node_modules\@xenova\transformers') OR !Exists('$(TransformersBundleDirectory)node_modules\esbuild')" />
    <Exec Command="npm run build" WorkingDirectory="$(TransformersBundleDirectory)" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)\$(TransformersBundleOutput)'))" />
    <Copy SourceFiles="$(TransformersBundleDirectory)dist\transformers.min.js" DestinationFiles="$(MSBuildProjectDirectory)\$(TransformersBundleOutput)" />
    <Copy SourceFiles="$(ThirdPartyNoticesSource)" DestinationFiles="$(MSBuildProjectDirectory)\$(ThirdPartyNoticesOutput)" />

    <ItemGroup>
      <Content Remove="$(TransformersBundleOutput);$(ThirdPartyNoticesOutput)" />
      <Content Include="$(TransformersBundleOutput);$(ThirdPartyNoticesOutput)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <SearchIndexInput Include="$(MSBuildThisFileDirectory)..\SharedModels\**\*.cs" />
    <SearchIndexInput Include="$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\**\*.cs" Exclude="$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\bin\**;$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\obj\**" />
    <SearchIndexInput Include="$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\VectorSearchIndexGenerator.csproj" />
    <SearchIndexInput Include="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
    <SearchIndexInput Include="$(MSBuildThisFileDirectory)..\Directory.Packages.props" />
    <SearchIndexInput Include="wwwroot\js\vector-search.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\chat\corpus\**" />
    <ChatCorpusInput Include="$(MSBuildThisFileDirectory)..\*DemoComponents\**\*.razor"
                     Exclude="$(MSBuildThisFileDirectory)..\**\bin\**;$(MSBuildThisFileDirectory)..\**\obj\**" />
    <ChatCorpusInput Include="$(MSBuildThisFileDirectory)..\SharedModels\**\*.cs" />
    <ChatCorpusInput Include="$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\**\*.cs"
                     Exclude="$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\bin\**;$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\obj\**" />
    <ChatCorpusInput Include="$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\VectorSearchIndexGenerator.csproj" />
    <ChatCorpusInput Include="$(MSBuildThisFileFullPath)" />
    <ChatCorpusInput Include="$(MSBuildThisFileDirectory)..\Directory.Build.props" />
    <ChatCorpusInput Include="$(MSBuildThisFileDirectory)..\Directory.Packages.props" />
  </ItemGroup>

  <Target Name="UpdateChatCorpusInventory">
    <MakeDir Directories="$(IntermediateOutputPath)chat-corpus" />
    <WriteLinesToFile File="$(IntermediateOutputPath)chat-corpus\inputs.txt"
                      Lines="@(ChatCorpusInput->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)chat-corpus\cutoff.txt"
                      Lines="$(ChatCorpusCutoff)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="GenerateChatCorpus"
          DependsOnTargets="UpdateChatCorpusInventory"
          Inputs="@(ChatCorpusInput);$(IntermediateOutputPath)chat-corpus\inputs.txt;$(IntermediateOutputPath)chat-corpus\cutoff.txt"
          Outputs="wwwroot\chat\corpus\manifest.json">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\VectorSearchIndexGenerator.csproj&quot; -- --chat &quot;$(MSBuildThisFileDirectory)wwwroot\chat\corpus&quot; --cutoff &quot;$(ChatCorpusCutoff)&quot;" />
  </Target>

  <Target Name="IncludeChatCorpusAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="GenerateChatCorpus">
    <ItemGroup>
      <Content Include="wwwroot\chat\corpus\**\*" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateContentVectorIndex" BeforeTargets="ResolveProjectStaticWebAssets" Inputs="@(SearchIndexInput)" Outputs="wwwroot\search\index.json;wwwroot\search\index.vec">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\VectorSearchIndexGenerator\VectorSearchIndexGenerator.csproj&quot; -- &quot;$(MSBuildThisFileDirectory)wwwroot\search&quot;" />

    <ItemGroup>
      <Content Remove="wwwroot\search\index.json;wwwroot\search\index.vec" />
      <Content Include="wwwroot\search\index.json;wwwroot\search\index.vec" />
    </ItemGroup>
  </Target>

  <!-- <ItemGroup Condition="'$(Configuration)'=='Release'">
  	<Content Remove="wwwroot\css\app.css" />
  	<None Include="wwwroot\css\app.css" />
  </ItemGroup> -->

  <Target Name="BuildCSS" BeforeTargets="PreBuildEvent" Condition="'$(Configuration)'=='Release'">
    <Exec Command="npm run buildcss" />
  </Target>
  
  <Target Name="CopyChartCSS" BeforeTargets="PreBuildEvent" Condition="'$(Configuration)'=='Release'">
  	<!-- https://jeremybytes.blogspot.com/2020/05/cross-platform-build-events-in-net-core.html -->
  
  	<ItemGroup>
  		<DataFiles Include="$(ProjectDir)\node_modules\charts.css\dist\charts.min.css" />
  	</ItemGroup>
  
  	<Copy SourceFiles="@(DataFiles)" DestinationFolder="$(ProjectDir)\wwwroot\css\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="GenerateRSSFeedXml" BeforeTargets="ResolveProjectStaticWebAssets" Condition="'$(WasmBuildingForNestedPublish)'!='true'">
    <PropertyGroup>
      <RSSFeedXmlFilePath>$([System.IO.Path]::Combine('wwwroot', 'atom.xml'))</RSSFeedXmlFilePath>
    </PropertyGroup>

    <Exec Command="dotnet run --project &quot;$(ProjectDir)../RSSFeedGenerator&quot; -p BuildScope=$(ProjectName) -o &quot;$(ProjectDir)$(RSSFeedXmlFilePath)&quot;" />

    <ItemGroup>
      <Content Remove="$(RSSFeedXmlFilePath)" />
      <Content Include="$(RSSFeedXmlFilePath)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateSitemapXml" BeforeTargets="PreBuildEvent" Condition="'$(Configuration)'!='Release'">
      <PropertyGroup>
          <SitemapXmlFilePath>$([System.IO.Path]::Combine('wwwroot', 'sitemap-channels.xml'))</SitemapXmlFilePath>
      </PropertyGroup>

      <Exec Command="dotnet run --project &quot;$(ProjectDir)../SitemapGenerator&quot; -p BuildScope=$(ProjectName) -o &quot;$(ProjectDir)$(SitemapXmlFilePath)&quot; --channel &quot;Channel&quot;" />

      <ItemGroup>
          <Content Remove="$(SitemapXmlFilePath)" />
          <Content Include="$(SitemapXmlFilePath)" />
      </ItemGroup>
  </Target>

</Project>
