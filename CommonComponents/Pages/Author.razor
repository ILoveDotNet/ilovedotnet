@page "/authors/{Name}"
@using Toolbelt.Blazor.HeadElement
@inherits AuthorBase
@inject AdSpaceService adSpaceService
@inject Sitemaps sitemap

<Title>@Title</Title>
<Meta Name="description" Content="@Description" />
<Meta Name="keywords" Content=".NET, DotNet, I Love DotNet, I ❤️ DotNet, Blazor, Blazor (WebAssembly), Blazor Wasm, C#, Entity Framework, EF Core, LINQ, Logging, ML.NET, Web API, TDD, OOPS, Middleware, JWT, Database, DDD, Dependency Injection, Report, Design Pattern, SOLID, HTTP Client, OWASP, SignalR, MSBuild, Regex, MAUI, MCP, Testing, AI, Caching, Security, JSON, NuGet, Memory" />
<Meta Property="url" Content="@Url" />
<Meta Property="identifier-URL" Content="@Url" />
<Meta Property="og:site_name" Content="@Title" />
<Meta Property="og:type" Content="website" />
<Meta Property="og:title" Content="@Title" />
<Meta Property="og:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="og:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="og:description" Content="@Description" />
<Meta Property="og:url" Content="@Url" />
<Meta Property="twitter:card" Content="summary" />
<Meta Property="twitter:title" Content="@Title" />
<Meta Property="twitter:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="twitter:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="twitter:description" Content="@Description" />
<Meta Property="twitter:url" Content="@Url" />
<Link Rel="sitemap" Href="@($"{BaseUrl}{sitemap.IndexFile}")" type="application/xml" title="Sitemap" />
<Link Rel="alternate" Href="@($"{BaseUrl}atom.xml")" type="application/atom+xml" />
<Link Rel="alternate" Href="@Url" hreflang="en" />
<Link Rel="alternate" Href="@Url" hreflang="x-default" />
<Link Rel="canonical" Href="@Url" />
<Link Rel="index" Href="@Url" title="@Title" />
<HeadContent>
    @(new MarkupString(
        $$""""
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "publisher": {
                "@type": "Organization",
                "name": "{{Title}}",
                "url": "{{Url}}",
                "logo": {
                    "@type": "ImageObject",
                    "url": "{{BaseUrl}}favicon.ico",
                    "width": 16,
                    "height": 16
                }
            },
            "url": "{{Url}}",
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": "{{Url}}"
            },
            "description": "{{Description}}"
        }
        </script>
        """"
    ))
</HeadContent>

<section class="[ min-w-0 bg-white dark:bg-stone-900 ]">
    <header>
        <div aria-hidden="true" class="[ h-28 md:h-40 bg-linear-to-r from-slate-950 via-indigo-950 to-purple-900 ]"></div>
        <div class="[ px-5 pb-6 md:px-8 ]">
            <img src="@($"./image/authors/{Name}.webp")" alt="@Author.Name" width="128" height="128"
                 class="[ relative -mt-12 h-24 w-24 rounded-full border-4 border-white object-cover md:-mt-16 md:h-32 md:w-32 dark:border-stone-900 ]" />
            <div class="[ mt-4 flex min-w-0 flex-col gap-3 ]">
                <h1 class="[ break-words text-3xl md:text-4xl font-bold text-stone-900 dark:text-white ]">@Author.Name</h1>
                <div class="[ flex flex-wrap items-center gap-3 ]">
                    @if (!string.IsNullOrWhiteSpace(Author.Role))
                    {
                        <p class="[ text-stone-600 dark:text-stone-300 ]">@Author.Role</p>
                    }
                    @if (Author.IsMVP)
                    {
                        <span class="[ rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-800 dark:bg-indigo-950 dark:text-indigo-200 ]">Microsoft MVP</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Author.Introduction))
                {
                    <p class="[ max-w-3xl leading-relaxed text-stone-600 dark:text-stone-300 ]">@Author.Introduction</p>
                }
                <nav aria-label="Author social profiles">
                    <ul role="list" class="[ flex flex-wrap gap-2 ]">
                        @foreach (var socialUrl in Author.SocialUrls.OrderBy(social => social.Type switch { SocialLink.LinkedIn => 0, SocialLink.GitHub => 1, SocialLink.Microsoft => 2, _ => 3 }))
                        {
                            <li>
                                <SocialLinks Type="@socialUrl.Type" Url="@socialUrl.Url"
                                             Label="@(socialUrl.Type == SocialLink.Microsoft ? "Microsoft MVP" : socialUrl.Type == SocialLink.BuyMeACoffee ? "Buy me a coffee" : socialUrl.Type.ToString())"
                                             CssClass="[ inline-flex min-h-11 items-center gap-2 rounded-lg border border-stone-200 px-3 py-2 text-sm text-stone-800 no-underline dark:border-stone-700 dark:text-stone-200 ] [ hover:bg-stone-100 dark:hover:bg-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]" />
                            </li>
                        }
                    </ul>
                </nav>
            </div>
            <dl aria-label="Author contributions" class="[ mt-6 grid grid-cols-2 gap-5 rounded-xl border border-stone-200 bg-stone-50 p-5 md:grid-cols-3 dark:border-stone-700 dark:bg-stone-800 ]">
                <div class="[ flex flex-col gap-1 ]">
                    <dt class="[ order-2 text-sm text-stone-600 dark:text-stone-300 ]">Published articles</dt>
                    <dd class="[ text-2xl font-bold tabular-nums text-indigo-700 dark:text-violet-300 ]">@PublishedArticleCount</dd>
                </div>
                <div class="[ flex flex-col gap-1 ]">
                    <dt class="[ order-2 text-sm text-stone-600 dark:text-stone-300 ]">Topics covered</dt>
                    <dd class="[ text-2xl font-bold tabular-nums text-indigo-700 dark:text-violet-300 ]">@PublishedTopicCount</dd>
                </div>
                @if (Author.IndustryExperienceYears is int years)
                {
                    <div class="[ flex flex-col gap-1 ]">
                        <dt class="[ order-2 text-sm text-stone-600 dark:text-stone-300 ]">Years in industry</dt>
                        <dd class="[ text-2xl font-bold tabular-nums text-indigo-700 dark:text-violet-300 ]">@(years)+</dd>
                    </div>
                }
            </dl>
        </div>
    </header>
    <div class="[ flex flex-col gap-8 px-5 pb-8 md:px-8 ]">
        <section aria-labelledby="author-about-title" class="[ flex flex-col gap-4 ]">
            <h2 id="author-about-title" class="[ text-2xl font-bold dark:text-white ]">About the author</h2>
            <p class="[ max-w-3xl leading-relaxed text-stone-700 dark:text-stone-300 ]">@Author.Description</p>
        </section>
        @if (Author.IsMVP)
        {
            <section aria-labelledby="author-recognition-title" class="[ flex flex-col gap-4 ]">
                <h2 id="author-recognition-title" class="[ text-2xl font-bold dark:text-white ]">Microsoft MVP recognition</h2>
                <img src="./image/authors/mvp-badge-horizontal.webp" alt="Microsoft Most Valuable Professional" class="[ w-full max-w-xs ]" width="1440" height="540" loading="lazy" />
                <div id="mvp-badge" class="[ flex flex-wrap gap-4 ]">
                    @foreach (var badge in Author.Badges)
                    {
                        <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="@badge" data-share-badge-host="https://www.credly.com"></div>
                    }
                </div>
                <script type="text/javascript" async src="https://cdn.credly.com/assets/utilities/embed.js"></script>
            </section>
        }
        @if (LatestArticles.Count > 0)
        {
            <section aria-labelledby="author-articles-title" class="[ flex flex-col gap-5 ]">
                <h2 id="author-articles-title" class="[ text-2xl font-bold dark:text-white ]">Latest articles by @Author.Name</h2>
                <div class="[ grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3 ]">
                    @foreach (var content in LatestArticles)
                    {
                        <Thumbnail @key="content.Slug" PosterUrl="@content.ThumbnailUrl" ContentUrl="@content.ContentUrl"
                                   Title="@content.Title" AltText="@content.Title" IconUrl="@content.IconUrl"
                                   IconAlt="@content.Channel" CreatedOn="@content.ModifiedOn" Author="@content.Author" />
                    }
                </div>
            </section>
        }
    </div>
</section>