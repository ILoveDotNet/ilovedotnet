@page "/notfound"
@layout MainLayout

<PageTitle>Page not found - I ❤️ DotNet</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<section aria-labelledby="not-found-title" class="[ flex min-h-[calc(100svh-7rem)] min-w-0 flex-col items-center justify-center gap-5 px-4 py-8 text-center text-stone-700 dark:text-stone-200 md:min-h-[calc(100svh-3.5rem)] ]">
    <img src="/image/error/error-404.webp" alt="Page not found" width="512" height="512" class="[ h-auto w-40 max-w-full sm:w-48 ]" />
    <div class="[ max-w-xl space-y-3 ]">
        <p class="[ text-sm font-bold tracking-widest text-indigo-700 dark:text-indigo-300 ]">404 <span aria-hidden="true">💔</span></p>
        <h1 id="not-found-title" class="[ text-3xl font-bold tracking-tight text-stone-900 dark:text-white sm:text-4xl ]">Page not found</h1>
        <p class="[ text-lg leading-relaxed ]">Sorry to break your heart, there's nothing at this address.</p>
        <p class="[ text-sm text-stone-600 dark:text-stone-300 ]">The link may be out of date, or the address may have been mistyped. Let's get you back to learning.</p>
    </div>
    <nav class="[ flex max-w-full flex-col items-center gap-3 ]" aria-label="Not found navigation">
        <div class="[ flex flex-wrap justify-center gap-3 ]">
            <NavLink href="/learningpath/" class="[ inline-flex min-h-11 items-center justify-center rounded-lg bg-indigo-700 px-4 py-2 font-semibold text-white hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:bg-indigo-400 dark:text-stone-950 dark:hover:bg-indigo-300 ]">Browse learning paths</NavLink>
            <NavLink href="/" class="[ inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-300 px-4 py-2 font-semibold hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:border-stone-600 dark:hover:bg-stone-800 ]">Go home</NavLink>
        </div>
    </nav>
</section>