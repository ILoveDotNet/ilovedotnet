<Meta Name="keywords" Content=".NET interview questions, dotnet interview questions and answers, C# interview questions, OOP interview questions, ASP.NET MVC interview questions, .NET Core interview questions, LINQ interview questions, Entity Framework interview questions, system design interview questions" />
<Meta Property="url" Content="@PageUrl" />
<Meta Property="identifier-URL" Content="@PageUrl" />
<Meta Property="og:site_name" Content="I ❤️ DotNet" />
<Meta Property="og:type" Content="website" />
<Meta Property="og:title" Content="@Title" />
<Meta Property="og:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="og:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="og:description" Content="@Description" />
<Meta Property="og:url" Content="@PageUrl" />
<Meta Property="twitter:card" Content="summary" />
<Meta Property="twitter:title" Content="@Title" />
<Meta Property="twitter:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="twitter:image:alt" Content="DotNet bot with heart and DotNet brand" />
