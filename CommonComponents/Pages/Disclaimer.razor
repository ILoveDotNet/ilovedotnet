@page "/disclaimer"
@using Toolbelt.Blazor.HeadElement
@inject IConfiguration configuration
@inject Sitemaps sitemap

<Title>@Title</Title>
<Meta Name="description" Content="@Description" />
<Meta Name="keywords" Content=".NET, DotNet, I Love DotNet, I ❤️ DotNet, Blazor, Blazor (WebAssembly), Blazor Wasm, C#, Entity Framework, EF Core, LINQ, Logging, ML.NET, Web API, TDD, OOPS, Middleware, JWT, Database, DDD, Dependency Injection, Report, Design Pattern, SOLID, HTTP Client, OWASP, SignalR, MSBuild, Regex, MAUI, MCP, Testing, AI, Caching, Security, JSON, NuGet, Memory" />
<Meta Property="url" Content="@PageUrl" />
<Meta Property="identifier-URL" Content="@PageUrl" />
<Meta Property="og:site_name" Content="@Title" />
<Meta Property="og:type" Content="website" />
<Meta Property="og:title" Content="@Title" />
<Meta Property="og:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="og:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="og:description" Content="@Description" />
<Meta Property="og:url" Content="@PageUrl" />
<Meta Property="twitter:card" Content="summary" />
<Meta Property="twitter:title" Content="@Title" />
<Meta Property="twitter:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="twitter:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="twitter:description" Content="@Description" />
<Meta Property="twitter:url" Content="@PageUrl" />
<Link Rel="sitemap" Href="@($"{BaseUrl}{sitemap.IndexFile}")" type="application/xml" title="Sitemap" />
<Link Rel="alternate" Href="@($"{BaseUrl}atom.xml")" type="application/atom+xml" />
<Link Rel="alternate" Href="@PageUrl" hreflang="en" />
<Link Rel="alternate" Href="@PageUrl" hreflang="x-default" />
<Link Rel="canonical" Href="@PageUrl" />
<Link Rel="index" Href="@PageUrl" title="@Title" />
<HeadContent>
    @(new MarkupString(
        $$""""
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "publisher": {
                "@type": "Organization",
                "name": "{{Title}}",
                "url": "{{BaseUrl}}",
                "logo": {
                    "@type": "ImageObject",
                    "url": "{{BaseUrl}}favicon.ico",
                    "width": 16,
                    "height": 16
                }
            },
            "url": "{{PageUrl}}",
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": "{{PageUrl}}"
            },
            "description": "{{Description}}"
        }
        </script>
        """"
    ))
</HeadContent>

<section aria-labelledby="disclaimer-title" class="[ mx-auto w-full min-w-0 max-w-[80ch] space-y-8 p-4 text-stone-700 dark:text-stone-200 md:p-6 ]">
    <header class="[ flex items-start gap-4 border-b border-stone-200 pb-6 dark:border-stone-700 ]">
        <span aria-hidden="true" class="[ flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 ]">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0 -2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2V8z"></path>
                <path d="M14 2v6h6M8 13h8M8 17h6"></path>
            </svg>
        </span>
        <div class="[ min-w-0 space-y-2 ]">
            <h1 id="disclaimer-title" class="[ text-3xl font-bold tracking-tight text-stone-900 dark:text-white md:text-4xl ]">Disclaimer</h1>
            <p class="[ leading-relaxed ]">Information about using I Love DotNet content, following external links, and changes to this disclaimer.</p>
        </div>
    </header>

    <article aria-label="Disclaimer terms" class="[ min-w-0 space-y-6 leading-relaxed [overflow-wrap:anywhere] [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-stone-900 [&_h2]:dark:text-white [&_p]:max-w-[75ch] [&_a]:underline [&_a]:underline-offset-2 [&_a]:focus-visible:outline-2 [&_a]:focus-visible:outline-indigo-500 ]">
    <section class="[ space-y-3 ]">
    <h2>Information and responsibility</h2>
    <p>
        All the information on this website – <a class="[ underline ]" href="https://ilovedotnet.org">https://ilovedotnet.org</a> – is 
        published in good faith and for general information purpose only. ilovedotnet does not make any warranties about the completeness, reliability 
        and accuracy of this information. Any action you take upon the information you find on this website (ilovedotnet), is strictly at your own 
        risk. ilovedotnet will not be liable for any losses and/or damages in connection with the use of our website.
    </p>
    </section>

    <section class="[ space-y-3 ]">
    <h2>External websites</h2>
    <p>
        From our website, you can visit other websites by following hyperlinks to such external sites. While we strive to provide only quality links 
        to useful and ethical websites, we have no control over the content and nature of these sites. These links to other websites do not imply a 
        recommendation for all the content found on these sites. Site owners and content may change without notice and may occur before we have the 
        opportunity to remove a link which may have gone ‘bad’.
    </p>

    <p>
        Please be also aware that when you leave our website, other sites may have different privacy policies and terms which are beyond our control. 
        Please be sure to check the Privacy Policies of these sites as well as their “Terms of Service” before engaging in any business or uploading 
        any information.
    </p>
    </section>

    <section class="[ space-y-3 ]">
    <h2>Consent</h2>

    <p>
        By using our website, you hereby consent to our disclaimer and agree to its terms.
    </p>
    </section>

    <section class="[ space-y-3 ]">
    <h2>Updates</h2>

    <p>
        Should we update, amend or make any changes to this document, those changes will be prominently posted here.
    </p>
    </section>
    </article>

    <footer class="[ space-y-5 border-t border-stone-200 pt-6 dark:border-stone-700 ]">
        <section aria-labelledby="disclaimer-contact-title" class="[ space-y-3 rounded-xl border border-indigo-200 bg-indigo-50 p-4 dark:border-indigo-900 dark:bg-indigo-950 ]">
            <h2 id="disclaimer-contact-title" class="[ text-lg font-semibold text-stone-900 dark:text-white ]">Questions about this disclaimer?</h2>
            <p class="[ leading-relaxed ]">
                If you require any more information or have any questions about our site’s disclaimer, please feel free to
                <a href="https://www.linkedin.com/in/fingers10" class="[ inline-flex min-h-11 items-center underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-indigo-500 ]">Contact Us</a>.
            </p>
        </section>
        <nav aria-label="Related pages" class="[ flex flex-wrap gap-x-6 gap-y-2 text-sm ]">
            <a href="/privacy/" class="[ inline-flex min-h-11 items-center underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-indigo-500 ]">Privacy Policy</a>
            <a href="/about/" class="[ inline-flex min-h-11 items-center underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-indigo-500 ]">About I Love DotNet</a>
        </nav>
    </footer>
</section>

@code {
    private string Title = "Disclaimer - I ❤️ DotNet";
    private string Description = "Read the I Love DotNet disclaimer covering informational content, external website links, responsibility, and updates.";
    private string BaseUrl => configuration.GetValue<string>("baseUrl")!;
    private string PageUrl => $"{BaseUrl}disclaimer/";
}