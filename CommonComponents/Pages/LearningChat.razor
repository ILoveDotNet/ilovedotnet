@page "/chat/"
@using CommonComponents.Models
@using Toolbelt.Blazor.HeadElement
@layout MainLayout
@inherits LearningChatBase
@inject Sitemaps sitemap

<Title>@Title</Title>
<Meta Name="description" Content="@Description" />
<Meta Name="robots" Content="noindex,follow" />
<Meta Name="keywords" Content=".NET, DotNet, I Love DotNet, I ❤️ DotNet, Learn with AI, Learning Chat, Blazor, Blazor WebAssembly, C#, Dependency Injection, EF Core, LINQ" />
<Meta Property="url" Content="@PageUrl" />
<Meta Property="identifier-URL" Content="@PageUrl" />
<Meta Property="og:site_name" Content="@Title" />
<Meta Property="og:type" Content="website" />
<Meta Property="og:title" Content="@Title" />
<Meta Property="og:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="og:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="og:description" Content="@Description" />
<Meta Property="og:url" Content="@PageUrl" />
<Meta Property="twitter:card" Content="summary" />
<Meta Property="twitter:title" Content="@Title" />
<Meta Property="twitter:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="twitter:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="twitter:description" Content="@Description" />
<Meta Property="twitter:url" Content="@PageUrl" />
<Link Rel="sitemap" Href="@($"{BaseUrl}{sitemap.IndexFile}")" type="application/xml" title="Sitemap" />
<Link Rel="alternate" Href="@($"{BaseUrl}atom.xml")" type="application/atom+xml" />
<Link Rel="alternate" Href="@PageUrl" hreflang="en" />
<Link Rel="alternate" Href="@PageUrl" hreflang="x-default" />
<Link Rel="canonical" Href="@PageUrl" />
<Link Rel="index" Href="@PageUrl" title="@Title" />
<HeadContent>
    @(new MarkupString(
        $$""""
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "publisher": {
                "@type": "Organization",
                "name": "I ❤️ DotNet",
                "url": {{System.Text.Json.JsonSerializer.Serialize(BaseUrl, LearningChatJsonContext.Default.String)}},
                "logo": {
                    "@type": "ImageObject",
                    "url": {{System.Text.Json.JsonSerializer.Serialize($"{BaseUrl}favicon.ico", LearningChatJsonContext.Default.String)}},
                    "width": 16,
                    "height": 16
                }
            },
            "url": {{System.Text.Json.JsonSerializer.Serialize(PageUrl, LearningChatJsonContext.Default.String)}},
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": {{System.Text.Json.JsonSerializer.Serialize(PageUrl, LearningChatJsonContext.Default.String)}}
            },
            "description": {{System.Text.Json.JsonSerializer.Serialize(Description, LearningChatJsonContext.Default.String)}}
        }
        </script>
        """"
    ))
</HeadContent>

<section aria-labelledby="learning-chat-title" class="[ h-[calc(100dvh-3.5rem)] overflow-hidden bg-stone-50 px-4 py-4 text-stone-900 dark:bg-stone-950 dark:text-stone-100 sm:px-6 md:py-6 max-md:[#main.pb-14_&]:h-[calc(100dvh-7rem)] ]">
    <div class="[ mx-auto flex h-full min-h-0 w-full max-w-5xl flex-col gap-4 ]">
        <header class="[ flex shrink-0 flex-wrap items-center justify-between gap-4 ]">
            <div class="[ flex items-center gap-3 ]">
                <div class="[ flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-700 dark:bg-indigo-400/15 dark:text-indigo-300 ]" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3a7 7 0 0 0-7 7v3a3 3 0 0 0 3 3h1v-6H8a3 3 0 0 0-3 3" />
                        <path d="M12 3a7 7 0 0 1 7 7v3a3 3 0 0 1-3 3h-1v-6h1a3 3 0 0 1 3 3" />
                        <path d="M9 19h6" />
                    </svg>
                </div>
                <div>
                    <h1 id="learning-chat-title" class="[ text-xl font-bold tracking-tight sm:text-2xl ]">Learn with AI</h1>
                    <p class="[ mt-0.5 text-sm text-stone-600 dark:text-stone-400 ]">Your .NET learning companion</p>
                </div>
            </div>
            <span class="[ inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-800 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-200 ]">
                <span class="[ h-2 w-2 rounded-full bg-amber-500 ]" aria-hidden="true"></span>
                @(generationReady ? "Local AI · verified article excerpts" : "Browser-local article search")
            </span>
        </header>

        <aside class="[ rounded-2xl border border-indigo-200 bg-indigo-50 p-4 text-sm text-indigo-950 dark:border-indigo-400/30 dark:bg-indigo-400/10 dark:text-indigo-100 ]" aria-label="Local answer model">
            <p class="[ text-indigo-950 dark:text-indigo-100 ]">@generationStatus</p>
            @if (generationLoading)
            {
                <progress max="1" value="@generationProgress" aria-label="Answer model loading progress"></progress>
                <button type="button" class="[ ml-3 text-indigo-700 underline dark:text-indigo-200 ]" @onclick="UseSourcesOnlyAsync">Cancel model loading</button>
            }
            else if (generationSupported && !generationReady)
            {
                <button type="button" class="[ mt-2 mr-4 font-semibold text-indigo-700 underline dark:text-indigo-200 ]" @onclick="LoadGenerationAsync" disabled="@isSearching">Download local answer model</button>
            }
            @if (generationReady)
            {
                <button type="button" class="[ mt-2 mr-4 text-indigo-700 underline dark:text-indigo-200 ]" @onclick="UseSourcesOnlyAsync" disabled="@isSearching">Use sources only</button>
            }
            @if (generationSupported && !generationLoading)
            {
                <button type="button" class="[ mt-2 text-indigo-700 underline dark:text-indigo-200 ]" @onclick="ClearGenerationCacheAsync" disabled="@isSearching">Clear answer model cache</button>
            }
        </aside>

        <section class="[ flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm dark:border-stone-800 dark:bg-stone-900 ]" aria-label="Learning chat">
            <div @ref="conversation" class="[ flex min-h-0 min-w-0 flex-1 flex-col overflow-y-auto overscroll-y-contain ]" aria-live="polite" tabindex="0" role="region" aria-label="Conversation">
                @if (messages.Count == 0)
                {
                    <div class="[ flex flex-1 shrink-0 flex-col items-center justify-center px-5 py-10 text-center sm:px-10 ]">
                        <div class="[ mb-5 flex h-16 w-16 items-center justify-center rounded-3xl bg-gradient-to-br from-indigo-600 to-violet-500 text-white shadow-lg shadow-indigo-500/20 ]" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="31" height="31" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m12 3 1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3Z" />
                                <path d="m19 14 1.1 2.9L23 18l-2.9 1.1L19 22l-1.1-2.9L15 18l2.9-1.1L19 14Z" />
                            </svg>
                        </div>
                        <p class="[ text-xs font-bold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300 ]">A little help with .NET</p>
                        <h2 class="[ mt-3 max-w-xl text-3xl font-bold tracking-tight sm:text-4xl ]">What would you like to learn today?</h2>
                        <p class="[ mt-3 max-w-lg text-sm leading-6 text-stone-600 dark:text-stone-400 sm:text-base ]">
                            Search published iLoveDotNet articles and inspect the original passages behind each result.
                        </p>

                        <div class="[ mt-6 max-w-2xl rounded-2xl border border-indigo-200 bg-indigo-50 p-4 text-left text-sm leading-6 text-indigo-950 dark:border-indigo-400/30 dark:bg-indigo-400/10 dark:text-indigo-100 ]">
                            <h3 class="[ font-semibold ]">Browser-local article search</h3>
                            <p class="[ mt-1 ]">Your question is embedded and matched in this browser. Opening this page automatically loads the article index and pinned embedding model, downloading from Hugging Face when it is not cached. No question or conversation is sent to an inference service. Optional WebGPU answers select original article sentences with verified references; source-only search remains available without the answer model.</p>
                            @if (!retrievalReady && !isLoading && (!string.IsNullOrWhiteSpace(errorMessage) || loadingCancelled))
                            {
                                <button type="button"
                                        class="[ mt-3 inline-flex min-h-11 items-center rounded-xl bg-indigo-700 px-4 py-2 font-semibold text-white hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 disabled:cursor-wait disabled:opacity-60 dark:bg-indigo-400 dark:text-stone-950 ]"
                                        @onclick="InitializeRetrievalAsync">
                                    Retry loading article search
                                </button>
                            }
                            else if (isLoading)
                            {
                                <button type="button"
                                        class="[ mt-3 inline-flex min-h-11 items-center rounded-xl border border-indigo-700 px-4 py-2 font-semibold text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:border-indigo-300 dark:text-indigo-200 ]"
                                        @onclick="CancelLoadingAsync">Cancel loading</button>
                            }
                        </div>

                        <div class="[ mt-8 grid w-full max-w-3xl gap-3 sm:grid-cols-2 ]">
                            @foreach (var prompt in SuggestedPrompts)
                            {
                                <button type="button"
                                        class="[ group flex min-h-16 items-center justify-between gap-3 rounded-2xl border border-stone-200 bg-white px-4 py-3 text-left text-sm font-medium text-stone-700 transition hover:border-indigo-300 hover:bg-indigo-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-200 dark:hover:border-indigo-400/60 dark:hover:bg-indigo-400/10 ]"
                                        @onclick="() => SelectPrompt(prompt)">
                                    <span>@prompt</span>
                                    <svg class="[ shrink-0 text-stone-400 transition group-hover:translate-x-0.5 group-hover:text-indigo-600 dark:group-hover:text-indigo-300 ]" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M5 12h14M13 6l6 6-6 6" />
                                    </svg>
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="[ flex shrink-0 flex-col gap-6 px-5 py-8 [overflow-wrap:anywhere] sm:px-8 ]">
                        @foreach (var message in messages)
                        {
                            <article class="@(message.IsUser ? "[ ml-auto max-w-2xl rounded-2xl rounded-br-md bg-indigo-700 px-5 py-4 text-white dark:bg-indigo-500 ]" : "[ mr-auto max-w-2xl rounded-2xl rounded-bl-md border border-stone-200 bg-stone-50 px-5 py-4 text-stone-800 dark:border-stone-700 dark:bg-stone-800 dark:text-stone-100 ]")">
                                <p class="[ mb-1 text-xs font-semibold opacity-75 ]">@(message.IsUser ? "You" : message.IsStreaming ? "Local AI · provisional draft" : message.IsGenerated ? "Local AI · verified article excerpts" : "Article search")</p>
                                <p class="[ whitespace-pre-wrap text-sm leading-6 ]" aria-live="@(message.IsStreaming ? "off" : null)">
                                    @if (message.IsGenerated)
                                    {
                                        @foreach (var part in AnswerParts(message))
                                        {
                                            @if (part.Source is not null)
                                            {
                                                <a href="@SourceUrl(part.Source)" class="[ text-indigo-700 underline dark:text-indigo-300 ]" title="@part.Source.Heading">@part.Text</a>
                                            }
                                            else
                                            {
                                                @part.Text
                                            }
                                        }
                                    }
                                    else
                                    {
                                        @message.Text
                                    }
                                </p>
                                @if (message.IsGenerated)
                                {
                                    <p class="[ mt-2 text-xs opacity-75 ]">AI-selected verbatim excerpts. Text and reference IDs are checked against the retrieved passages; check whether the selected sentences fully answer your question.</p>
                                }
                                @if (message.Sources.Count > 0)
                                {
                                    <ol class="[ mt-4 space-y-3 ]" aria-label="Retrieved article sources">
                                        @foreach (var source in message.Sources)
                                        {
                                            <li class="[ rounded-xl border border-stone-200 bg-white p-4 dark:border-stone-700 dark:bg-stone-900 ]">
                                                <a href="@SourceUrl(source)" class="[ font-semibold text-indigo-700 underline dark:text-indigo-300 ]">@source.Title</a>
                                                <p class="[ mt-1 text-xs font-medium text-stone-600 dark:text-stone-400 ]">@source.Section · @source.Heading</p>
                                                <blockquote class="[ mt-2 border-l-2 border-indigo-300 pl-3 text-sm leading-6 text-stone-700 dark:border-indigo-400 dark:text-stone-300 ]">@source.Excerpt</blockquote>
                                            </li>
                                        }
                                    </ol>
                                }
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="[ shrink-0 border-t border-stone-200 p-4 dark:border-stone-800 sm:p-5 ]">
                <form class="[ mx-auto max-w-3xl ]" @onsubmit="SendQuestionAsync" @onsubmit:preventDefault>
                    <label for="chat-question" class="[ sr-only ]">Your question</label>
                    <div class="[ flex items-end gap-3 rounded-2xl border border-stone-300 bg-white p-2 shadow-sm transition focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100 dark:border-stone-700 dark:bg-stone-950 dark:focus-within:border-indigo-400 dark:focus-within:ring-indigo-400/10 ]">
                        <textarea id="chat-question"
                                  @ref="questionInput"
                                  @bind="draft"
                                  @bind:event="oninput"
                                  maxlength="1000"
                                  rows="2"
                                  placeholder="Ask about an article..."
                                  aria-describedby="chat-keyboard-hint"
                                  class="[ max-h-36 min-h-12 flex-1 resize-y bg-transparent px-3 py-2 text-sm leading-6 text-stone-900 outline-none placeholder:text-stone-400 dark:text-white ]"></textarea>
                        @if (isSearching)
                        {
                            <button type="button"
                                    class="[ mb-0.5 inline-flex h-10 shrink-0 items-center justify-center rounded-xl border border-stone-300 px-3 text-sm font-semibold text-stone-700 focus-visible:outline-2 focus-visible:outline-indigo-500 dark:border-stone-700 dark:text-stone-200 ]"
                                    @onclick="StopSearchAsync">Stop</button>
                        }
                        <button type="submit"
                                disabled="@(!retrievalReady || isSearching || string.IsNullOrWhiteSpace(draft))"
                                class="[ mb-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-700 text-white transition hover:bg-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 disabled:cursor-not-allowed disabled:bg-stone-300 dark:bg-indigo-400 dark:text-stone-950 dark:hover:bg-indigo-300 dark:disabled:bg-stone-700 ]"
                                aria-label="Send question">
                            <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m5 12 14-7-4 14-3-6-7-1Z" />
                                <path d="m12 13 7-8" />
                            </svg>
                        </button>
                    </div>
                    <div class="[ mt-2 flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-stone-500 dark:text-stone-400 ]">
                        <p role="status" aria-live="polite">@statusMessage</p>
                        <button type="button" class="[ underline ]" @onclick="NewConversationAsync" disabled="@(messages.Count == 0)">New conversation</button>
                        <span>@draft.Length / 1000</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <p class="[ mt-2 px-1 text-sm text-red-700 dark:text-red-300 ]" role="alert">@errorMessage</p>
                        <button type="button" class="[ mt-1 px-1 text-left text-sm font-semibold underline ]" @onclick="RetryLastQuestionAsync">Retry last question</button>
                    }
                    <p id="chat-keyboard-hint" class="[ mt-2 px-1 text-xs text-stone-500 dark:text-stone-400 ]">Enter to search · Shift+Enter for a new line. Verify technical details in the linked articles.</p>
                </form>
            </div>
        </section>
    </div>
</section>
