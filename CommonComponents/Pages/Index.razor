@page "/"
@using Toolbelt.Blazor.HeadElement
@inject IConfiguration configuration
@inject Sitemaps sitemap
@inject TableOfContents tableOfContents
@inject IJSRuntime JSRuntime

<Title>@Title</Title>
<Meta Name="description" Content="@Description" />
<Meta Name="keywords" Content=".NET, DotNet, I Love DotNet, I ❤️ DotNet, Blazor, Blazor (WebAssembly), Blazor Wasm, C#, Entity Framework, EF Core, LINQ, Logging, ML.NET, Web API, TDD, OOPS, Middleware, JWT, Database, DDD, Dependency Injection, Report, Design Pattern, SOLID, HTTP Client, OWASP, SignalR, MSBuild, Regex, MAUI, MCP, Testing, AI, Aspire, Caching, Security, JSON, NuGet, Memory" />
<Meta Property="url" Content="@BaseUrl" />
<Meta Property="identifier-URL" Content="@BaseUrl" />
<Meta Property="og:site_name" Content="@Title" />
<Meta Property="og:type" Content="website" />
<Meta Property="og:title" Content="@Title" />
<Meta Property="og:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="og:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="og:description" Content="@Description" />
<Meta Property="og:url" Content="@BaseUrl" />
<Meta Property="twitter:card" Content="summary" />
<Meta Property="twitter:title" Content="@Title" />
<Meta Property="twitter:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="twitter:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="twitter:description" Content="@Description" />
<Meta Property="twitter:url" Content="@BaseUrl" />
<Link Rel="sitemap" Href="@($"{BaseUrl}{sitemap.IndexFile}")" type="application/xml" title="Sitemap" />
<Link Rel="alternate" Href="@($"{BaseUrl}atom.xml")" type="application/atom+xml" />
<Link Rel="alternate" Href="@BaseUrl" hreflang="en" />
<Link Rel="alternate" Href="@BaseUrl" hreflang="x-default" />
<Link Rel="canonical" Href="@BaseUrl" />
<Link Rel="index" Href="@BaseUrl" title="@Title" />
<HeadContent>
    @(new MarkupString(
        $$""""
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "publisher": {
                "@type": "Organization",
                "name": "{{Title}}",
                "url": "{{BaseUrl}}",
                "logo": {
                    "@type": "ImageObject",
                    "url": "{{BaseUrl}}favicon.ico",
                    "width": 16,
                    "height": 16
                }
            },
            "url": "{{BaseUrl}}",
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": "{{BaseUrl}}"
            },
            "description": "{{Description}}"
        }
        </script>
        """"
    ))
</HeadContent>

<header class="[ p-3 dark:bg-stone-900 md:p-5 ]">
    <div class="[ overflow-hidden rounded-2xl bg-indigo-950 text-white ]">
        <div class="[ grid min-w-0 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] ]">
            <div class="[ flex min-w-0 flex-col items-start justify-center gap-6 p-6 sm:p-10 xl:p-14 ]">
                <h1 class="[ max-w-[12ch] text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-5xl xl:text-6xl ]">Learn .NET by building.</h1>
                <p class="[ max-w-xl text-base leading-relaxed text-indigo-100 sm:text-lg ]">Practical .NET tutorials, working examples, and learning paths for developers.</p>
                <div class="[ flex flex-wrap items-center gap-x-5 gap-y-3 ]">
                    <a href="/learningpath/" class="[ inline-flex min-h-12 items-center justify-center gap-3 rounded-lg bg-white px-5 py-3 font-bold text-indigo-950 no-underline hover:bg-indigo-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white ]">
                        Explore learning paths <span aria-hidden="true">→</span>
                    </a>
                    <a href="https://whatsapp.com/channel/0029VaAGMV2LtOj5S5MHd23h" target="_blank" rel="noopener noreferrer"
                       class="[ inline-flex min-h-12 items-center gap-2 font-semibold text-white underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white ]">
                        Follow on WhatsApp <span class="sr-only">(opens in a new tab)</span>
                    </a>
                </div>
                <p class="[ max-w-xl text-sm leading-relaxed text-indigo-100 ]">Get practical .NET tutorials and updates in our WhatsApp channel.</p>
            </div>
            <nav aria-label="Choose your learning journey" class="[ min-w-0 bg-indigo-100 p-6 text-indigo-950 sm:p-10 xl:p-12 ]">
                <h2 class="[ mb-4 text-2xl font-bold tracking-tight text-indigo-950 sm:text-3xl ]">Where will you go next?</h2>
                <p class="[ mb-6 max-w-md leading-relaxed text-indigo-900 ]">Pick a starting point. Each path is yours to explore at your own pace.</p>
                <ul role="list" class="[ divide-y divide-indigo-300 border-y border-indigo-300 ]">
                    <li>
                        <a href="/learningpath/" class="[ group flex min-h-20 items-center gap-4 py-4 text-indigo-950 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 ]">
                            <span aria-hidden="true" class="[ flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-indigo-700 text-lg font-bold text-white ]">&lt;/&gt;</span>
                            <span class="[ min-w-0 flex-1 ]"><strong class="[ block text-lg group-hover:underline ]">Learn .NET</strong><span class="[ block text-sm leading-relaxed text-indigo-900 ]">Follow tutorials and working examples.</span></span>
                            <span aria-hidden="true" class="[ text-2xl ]">↗</span>
                        </a>
                    </li>
                    <li>
                        <a href="/interview/" class="[ group flex min-h-20 items-center gap-4 py-4 text-indigo-950 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 ]">
                            <span aria-hidden="true" class="[ flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber-300 text-xl font-bold text-amber-950 ]">?</span>
                            <span class="[ min-w-0 flex-1 ]"><strong class="[ block text-lg group-hover:underline ]">Prepare for interviews</strong><span class="[ block text-sm leading-relaxed text-indigo-900 ]">Practise questions and system design.</span></span>
                            <span aria-hidden="true" class="[ text-2xl ]">↗</span>
                        </a>
                    </li>
                    <li>
                        <a href="/career/" class="[ group flex min-h-20 items-center gap-4 py-4 text-indigo-950 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 ]">
                            <span aria-hidden="true" class="[ flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-teal-300 text-xl font-bold text-teal-950 ]">↑</span>
                            <span class="[ min-w-0 flex-1 ]"><strong class="[ block text-lg group-hover:underline ]">Grow your career</strong><span class="[ block text-sm leading-relaxed text-indigo-900 ]">Turn your experience into impact.</span></span>
                            <span aria-hidden="true" class="[ text-2xl ]">↗</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</header>

@if (FeaturedTutorial is { } featured)
{
    <section aria-labelledby="featured-tutorial-title" class="[ dark:bg-stone-900 p-3 md:p-5 border-b-2 dark:border-gray-800 ]">
        <div data-featured-tutorial class="[ grid min-w-0 overflow-hidden rounded-2xl bg-stone-100 text-stone-900 md:grid-cols-2 dark:bg-stone-800 dark:text-white ]">
            <div class="[ flex min-w-0 flex-col items-start justify-center gap-4 p-6 sm:p-8 lg:p-10 ]">
                <h2 id="featured-tutorial-title" class="[ text-2xl font-bold tracking-tight sm:text-3xl ]">Start with a recent tutorial</h2>
                <p class="[ text-sm font-semibold text-indigo-700 dark:text-indigo-300 ]">@featured.Channel · Updated @featured.ModifiedOn.ToString("d MMM yyyy")</p>
                <h3 class="[ break-words text-xl font-bold sm:text-2xl ]">@featured.Title</h3>
                <p class="[ max-w-xl leading-relaxed text-stone-700 dark:text-stone-300 ]">@featured.Description</p>
                <a href="@($"/{featured.ContentUrl.Trim('/')}/")"
                   class="[ inline-flex min-h-11 items-center gap-2 font-bold text-indigo-700 underline underline-offset-4 dark:text-indigo-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]">
                    Read this tutorial <span aria-hidden="true">→</span><span class="sr-only">: @featured.Title</span>
                </a>
            </div>
            <div class="[ flex min-w-0 items-center p-6 pt-0 sm:p-8 sm:pt-0 md:p-8 lg:p-10 ]">
                <img src="@featured.ThumbnailUrl" alt="@featured.Title" loading="lazy" width="1265" height="827"
                     class="[ block aspect-[1265/827] w-full rounded-lg object-contain ]" />
            </div>
        </div>
    </section>
}

<section aria-labelledby="latest-tutorials-title" class="[ min-w-0 dark:bg-stone-900 flex flex-col space-y-5 p-4 md:p-5 border-b-2 dark:border-gray-800 ]">
    <header class="[ space-y-2 ]">
        <h2 id="latest-tutorials-title" class="[ text-2xl font-bold dark:text-white ]">@(SelectedContentType is null ? "Latest tutorials" : $"Latest {SelectedContentType} tutorials")</h2>
        <p class="[ text-sm text-stone-600 dark:text-stone-300 ]">Browse tutorials by most recently updated.</p>
    </header>
    <ContentTypes OnSelectedContentType="FilterContent"></ContentTypes>
    <p role="status" class="[ text-sm text-stone-600 dark:text-stone-300 ]">Showing @Contents.Count() of @MatchingArticleCount tutorials</p>
    @if (!Contents.Any())
    {
        <p class="[ rounded-lg border border-stone-200 p-4 dark:border-stone-700 ]">No published tutorials in this topic yet. Choose All or explore another topic.</p>
    }
    <div class="[ grid min-w-0 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4 ]">
        @foreach (var content in Contents)
        {
            <Thumbnail @key="@content.Slug" PosterUrl="@content.ThumbnailUrl"
                    ContentUrl="@content.ContentUrl"
                    Title="@content.Title"
                    AltText="@content.Title"
                    IconUrl="@content.IconUrl"
                    IconAlt="@content.Channel"
                    Channel="@content.Channel"
                    CreatedOn="@content.ModifiedOn"
                    Author="@content.Author"
                    HeadingLevel="3">
            </Thumbnail>
        }
    </div>
    @if (Contents.Count() < MatchingArticleCount)
    {
        <div class="[ flex items-center justify-center ]">
            <button type="button"
                    class="[ inline-flex min-h-11 cursor-pointer items-center justify-center rounded-lg border border-stone-300 px-4 py-2 font-semibold hover:bg-stone-100 dark:border-stone-600 dark:hover:bg-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]"
                    @onclick="ShowMoreContents">
                Show more tutorials
            </button>
        </div>
    }
</section>

<div class="[ dark:bg-stone-900 ] [ p-3 md:p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <InterviewPreparationBanner />
</div>

<section aria-labelledby="channels-title" class="[ dark:bg-stone-900 ] [ flex min-w-0 flex-col ] [ space-y-5 ] [ p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <header class="[ flex flex-wrap items-center gap-2 ]">
        <svg xmlns="http://www.w3.org/2000/svg" class="[ icon icon-tabler icon-tabler-track ] [ text-red-600 ]" width="30" height="30" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M4 15l11 -11m5 5l-11 11m-4 -8l7 7m-3.5 -10.5l7 7m-3.5 -10.5l7 7"></path>
        </svg>
        <h2 id="channels-title" class="[ text-2xl font-bold ] [ dark:text-gray-200 ]">Channels</h2>
        <a href="/learningpath/" class="[ inline-flex min-h-11 items-center px-2 text-sm font-semibold text-indigo-700 underline dark:text-indigo-300 focus-visible:outline-2 focus-visible:outline-indigo-500 ]">View all learning paths</a>
        <div class="[ ml-auto hidden gap-2 md:flex ]">
            <button type="button" aria-label="Previous channels" aria-controls="channel-shelf"
                    class="[ flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-stone-300 ] [ dark:border-stone-700 ] [ hover:bg-stone-100 dark:hover:bg-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]"
                    @onclick="() => ScrollChannelsAsync(-1)">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m14 6-6 6 6 6"></path>
                </svg>
            </button>
            <button type="button" aria-label="Next channels" aria-controls="channel-shelf"
                    class="[ flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-stone-300 ] [ dark:border-stone-700 ] [ hover:bg-stone-100 dark:hover:bg-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]"
                    @onclick="() => ScrollChannelsAsync(1)">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m10 6 6 6-6 6"></path>
                </svg>
            </button>
        </div>
    </header>
    <div class="[ min-w-0 max-w-full ]">
        <ul id="channel-shelf" @ref="ChannelShelf" role="list" aria-label="Browse topic channels"
            class="[ flex list-none items-stretch gap-3 overflow-x-auto overscroll-x-contain snap-x snap-proximity scroll-p-1 p-1 pb-3 ]">
            @foreach (var channel in Channels)
            {
                <li @key="channel.Name" class="[ w-44 shrink-0 snap-start md:w-48 ]">
                    <NavLink href="@($"/channels/{channel.Name.ToLower().ApplyHyphen()}/")"
                             class="[ flex h-full flex-col gap-3 rounded-xl border border-stone-200 bg-white p-4 text-stone-900 no-underline ] [ dark:border-stone-700 dark:bg-stone-800 dark:text-white ] [ hover:border-indigo-400 hover:bg-indigo-50 dark:hover:border-violet-400 dark:hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]">
                        <img src="@channel.IconUrl" alt="" loading="lazy" width="40" height="40" class="[ h-10 w-10 rounded-lg object-contain ]" />
                        <span class="[ break-words text-base font-bold ]">@channel.Name</span>
                        <span class="[ mt-auto flex items-center justify-between gap-2 text-sm text-stone-600 dark:text-stone-300 ]">
                            <span>@(channel.ArticleCount == 0 ? "Coming soon" : $"{channel.ArticleCount} {(channel.ArticleCount == 1 ? "article" : "articles")}")</span>
                            <svg aria-hidden="true" class="[ shrink-0 ]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14m-6-6 6 6-6 6"></path>
                            </svg>
                        </span>
                    </NavLink>
                </li>
            }
        </ul>
    </div>
</section>

<section aria-labelledby="learning-stats-title" class="[ dark:bg-stone-900 ] [ p-3 md:p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <div class="[ rounded-2xl border border-stone-200 bg-stone-50 p-5 md:p-8 ] [ dark:border-stone-800 dark:bg-stone-950 ]">
        <h2 id="learning-stats-title" class="[ sr-only ]">Learning at I Love .NET</h2>
        <dl class="[ grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-7 ] [ text-center ]">
