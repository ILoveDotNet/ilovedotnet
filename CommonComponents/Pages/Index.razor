@page "/"
@using Toolbelt.Blazor.HeadElement
@inject IConfiguration configuration
@inject Sitemaps sitemap
@inject TableOfContents tableOfContents
@inject IJSRuntime JSRuntime

<Title>@Title</Title>
<Meta Name="description" Content="@Description" />
<Meta Name="keywords" Content=".NET, DotNet, I Love DotNet, I ❤️ DotNet, Blazor, Blazor (WebAssembly), Blazor Wasm, C#, Entity Framework, EF Core, LINQ, Logging, ML.NET, Web API, TDD, OOPS, Middleware, JWT, Database, DDD, Dependency Injection, Report, Design Pattern, SOLID, HTTP Client, OWASP, SignalR, MSBuild, Regex, MAUI, MCP, Testing, AI, Caching, Security, JSON, NuGet, Memory" />
<Meta Property="url" Content="@BaseUrl" />
<Meta Property="identifier-URL" Content="@BaseUrl" />
<Meta Property="og:site_name" Content="@Title" />
<Meta Property="og:type" Content="website" />
<Meta Property="og:title" Content="@Title" />
<Meta Property="og:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="og:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="og:description" Content="@Description" />
<Meta Property="og:url" Content="@BaseUrl" />
<Meta Property="twitter:card" Content="summary" />
<Meta Property="twitter:title" Content="@Title" />
<Meta Property="twitter:image" Content="@($"{BaseUrl}image/brand/mini-logo.png")" />
<Meta Property="twitter:image:alt" Content="DotNet bot with heart and DotNet brand" />
<Meta Property="twitter:description" Content="@Description" />
<Meta Property="twitter:url" Content="@BaseUrl" />
<Link Rel="sitemap" Href="@($"{BaseUrl}{sitemap.IndexFile}")" type="application/xml" title="Sitemap" />
<Link Rel="alternate" Href="@($"{BaseUrl}atom.xml")" type="application/atom+xml" />
<Link Rel="alternate" Href="@BaseUrl" hreflang="en" />
<Link Rel="alternate" Href="@BaseUrl" hreflang="x-default" />
<Link Rel="canonical" Href="@BaseUrl" />
<Link Rel="index" Href="@BaseUrl" title="@Title" />
<HeadContent>
    @(new MarkupString(
        $$""""
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "publisher": {
                "@type": "Organization",
                "name": "{{Title}}",
                "url": "{{BaseUrl}}",
                "logo": {
                    "@type": "ImageObject",
                    "url": "{{BaseUrl}}favicon.ico",
                    "width": 16,
                    "height": 16
                }
            },
            "url": "{{BaseUrl}}",
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": "{{BaseUrl}}"
            },
            "description": "{{Description}}"
        }
        </script>
        """"
    ))
</HeadContent>

<h1 class="[ sr-only ]">I ❤️ .NET: free .NET, C# and Blazor tutorials</h1>

<section class="[ dark:bg-stone-900 ] [ flex flex-col ] [ space-y-5 ] [ p-1 md:p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <ContentTypes OnSelectedContentType="FilterContent"></ContentTypes>
    <div class="[ grid grid-cols-1 md:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-4 ]">
        @foreach (var (content, index) in Contents.SelectWithIndex())
        {
            <Thumbnail @key="@index" PosterUrl="@content.ThumbnailUrl" 
                    ContentUrl="@content.ContentUrl"
                    Title="@content.Title"
                    AltText="@content.Title"
                    IconUrl="@content.IconUrl"
                    IconAlt="@content.Channel"
                    CreatedOn="@content.ModifiedOn"
                    Author="@content.Author">
            </Thumbnail>           
        }
    </div>
    <div class="[ flex items-center justify-center ]">
        <button type="button" 
                class="[ cursor-pointer ] [ px-3 py-1 ] [ rounded-md ] [ whitespace-nowrap ] [ flex items-center justify-center ] [ disabled:opacity-75 disabled:cursor-not-allowed ]"
                @onclick="ShowMoreContents"
                disabled="@(Take >= tableOfContents.SelectedContentTypeTotalCount(SelectedContentType))">
            <svg xmlns="http://www.w3.org/2000/svg" class="[ icon icon-tabler icon-tabler-caret-down ]" width="30" height="30" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M6 10l6 6l6 -6h-12"></path>
            </svg>
            <p>Show more</p>
        </button>
    </div>
</section>

<div class="[ dark:bg-stone-900 ] [ p-3 md:p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <InterviewPreparationBanner />
</div>

<section aria-labelledby="channels-title" class="[ dark:bg-stone-900 ] [ flex min-w-0 flex-col ] [ space-y-5 ] [ p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <header class="[ flex items-center gap-2 ]">
        <svg xmlns="http://www.w3.org/2000/svg" class="[ icon icon-tabler icon-tabler-track ] [ text-red-600 ]" width="30" height="30" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M4 15l11 -11m5 5l-11 11m-4 -8l7 7m-3.5 -10.5l7 7m-3.5 -10.5l7 7"></path>
        </svg>
        <h2 id="channels-title" class="[ text-2xl font-bold ] [ dark:text-gray-200 ]">Channels</h2>
        <div class="[ ml-auto hidden gap-2 md:flex ]">
            <button type="button" aria-label="Previous channels" aria-controls="channel-shelf"
                    class="[ flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-stone-300 ] [ dark:border-stone-700 ] [ hover:bg-stone-100 dark:hover:bg-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]"
                    @onclick="() => ScrollChannelsAsync(-1)">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m14 6-6 6 6 6"></path>
                </svg>
            </button>
            <button type="button" aria-label="Next channels" aria-controls="channel-shelf"
                    class="[ flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-stone-300 ] [ dark:border-stone-700 ] [ hover:bg-stone-100 dark:hover:bg-stone-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]"
                    @onclick="() => ScrollChannelsAsync(1)">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m10 6 6 6-6 6"></path>
                </svg>
            </button>
        </div>
    </header>
    <div class="[ min-w-0 max-w-full ]">
        <ul id="channel-shelf" @ref="ChannelShelf" role="list" aria-label="Browse topic channels"
            class="[ flex list-none items-stretch gap-3 overflow-x-auto overscroll-x-contain snap-x snap-proximity scroll-p-1 p-1 pb-3 ]">
            @foreach (var channel in Channels)
            {
                <li @key="channel.Name" class="[ w-44 shrink-0 snap-start md:w-48 ]">
                    <NavLink href="@($"/channels/{channel.Name.ToLower().ApplyHyphen()}/")"
                             class="[ flex h-full flex-col gap-3 rounded-xl border border-stone-200 bg-white p-4 text-stone-900 no-underline ] [ dark:border-stone-700 dark:bg-stone-800 dark:text-white ] [ hover:border-indigo-400 hover:bg-indigo-50 dark:hover:border-violet-400 dark:hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]">
                        <img src="@channel.IconUrl" alt="" loading="lazy" width="40" height="40" class="[ h-10 w-10 rounded-lg object-contain ]" />
                        <span class="[ break-words text-base font-bold ]">@channel.Name</span>
                        <span class="[ mt-auto flex items-center justify-between gap-2 text-sm text-stone-600 dark:text-stone-300 ]">
                            <span>@channel.ArticleCount @(channel.ArticleCount == 1 ? "article" : "articles")</span>
                            <svg aria-hidden="true" class="[ shrink-0 ]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 12h14m-6-6 6 6-6 6"></path>
                            </svg>
                        </span>
                    </NavLink>
                </li>
            }
        </ul>
    </div>
</section>

<section aria-labelledby="learning-stats-title" class="[ dark:bg-stone-900 ] [ p-3 md:p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <div class="[ rounded-2xl border border-stone-200 bg-stone-50 p-5 md:p-8 ] [ dark:border-stone-800 dark:bg-stone-950 ]">
        <h2 id="learning-stats-title" class="[ sr-only ]">Learning at I Love .NET</h2>
        <dl class="[ grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-7 ] [ text-center ]">
            <div class="[ flex min-w-0 flex-col gap-2 ]">
                <dt class="[ order-2 text-sm text-stone-600 dark:text-stone-300 ]">Published articles</dt>
                <dd class="[ text-3xl md:text-4xl font-bold tabular-nums text-indigo-700 dark:text-violet-300 ]">@PublishedArticleCount</dd>
            </div>
            <div class="[ flex min-w-0 flex-col gap-2 ]">
                <dt class="[ order-2 text-sm text-stone-600 dark:text-stone-300 ]">.NET topic channels</dt>
                <dd class="[ text-3xl md:text-4xl font-bold tabular-nums text-indigo-700 dark:text-violet-300 ]">@PublishedChannelCount</dd>
            </div>
            <div class="[ flex min-w-0 flex-col gap-2 ]">
                <dt class="[ order-2 text-sm text-stone-600 dark:text-stone-300 ]">Years sharing .NET knowledge</dt>
                <dd class="[ text-3xl md:text-4xl font-bold tabular-nums text-indigo-700 dark:text-violet-300 ]">6+</dd>
            </div>
            <div class="[ flex min-w-0 flex-col gap-2 ]">
                <dt class="[ order-2 text-sm text-stone-600 dark:text-stone-300 ]">Years of author industry experience</dt>
                <dd class="[ text-3xl md:text-4xl font-bold tabular-nums text-indigo-700 dark:text-violet-300 ]">10+</dd>
            </div>
        </dl>
        <ul role="list" class="[ mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t border-stone-200 pt-5 ] [ text-center text-sm text-stone-600 ] [ dark:border-stone-800 dark:text-stone-300 ]">
            <li><strong class="[ font-semibold text-stone-900 dark:text-white ]">100% free</strong> to learn</li>
            <li>A new article every <strong class="[ font-semibold text-stone-900 dark:text-white ]">Sunday</strong></li>
        </ul>
    </div>
</section>

<section class="[ dark:bg-stone-900 ] [ flex flex-col ] [ space-y-5 ] [ p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <header class="[ flex ] [ space-x-2 ]">
        <svg xmlns="http://www.w3.org/2000/svg" class="[ icon icon-tabler icon-tabler-writing-sign ] [ text-fuchsia-600 ]" width="30" height="30" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 19c3.333 -2 5 -4 5 -6c0 -3 -1 -3 -2 -3s-2.032 1.085 -2 3c.034 2.048 1.658 2.877 2.5 4c1.5 2 2.5 2.5 3.5 1c.667 -1 1.167 -1.833 1.5 -2.5c1 2.333 2.333 3.5 4 3.5h2.5"></path>
            <path d="M20 17v-12c0 -1.121 -.879 -2 -2 -2s-2 .879 -2 2v12l2 2l2 -2z"></path>
            <path d="M16 7h4"></path>
        </svg>
        <h2 id="homepage-authors-title" class="[ text-2xl font-bold ] [ dark:text-gray-200 ]">@(tableOfContents.Authors.Count == 1 ? "Meet the author" : "Meet the authors")</h2>
    </header>
    <div class="[ max-w-full ]">
        <ul aria-labelledby="homepage-authors-title" role="list" class="[ grid grid-cols-1 gap-4 ]">
            @foreach (var author in tableOfContents.Authors)
            {
                <li @key="author.Name" class="[ min-w-0 ]">
                    <NavLink href="@($"/authors/{author.Name.ToLower().ApplyHyphen()}/")"
                             class="[ flex flex-col items-start gap-5 rounded-xl border border-stone-200 bg-white p-5 text-stone-900 no-underline sm:flex-row sm:items-center md:p-6 ] [ dark:border-stone-700 dark:bg-stone-800 dark:text-white ] [ hover:border-indigo-400 hover:bg-indigo-50 dark:hover:border-violet-400 dark:hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 ]">
                        <img src="@($"image/authors/{author.Name.ToLowerInvariant()}.webp")" alt="" loading="lazy" width="96" height="96"
                             class="[ h-24 w-24 shrink-0 rounded-full object-cover ]" />
                        <div class="[ flex min-w-0 flex-col gap-3 ]">
                            <h3 class="[ break-words text-xl font-bold ]">@author.Name</h3>
                            <div class="[ flex flex-wrap items-center gap-2 text-sm ]">
                                @if (!string.IsNullOrWhiteSpace(author.Role))
                                {
                                    <span class="[ text-stone-600 dark:text-stone-300 ]">@author.Role</span>
                                }
                                @if (author.IsMVP)
                                {
                                    <span class="[ rounded-full bg-indigo-50 px-3 py-1 font-semibold text-indigo-800 dark:bg-indigo-950 dark:text-indigo-200 ]">Microsoft MVP</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(author.Introduction))
                            {
                                <p class="[ max-w-3xl leading-relaxed text-stone-600 dark:text-stone-300 ]">@author.Introduction</p>
                            }
                            <span class="[ inline-flex items-center gap-2 text-sm font-semibold text-indigo-700 dark:text-violet-300 ]">
                                View author profile
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14m-6-6 6 6-6 6"></path>
                                </svg>
                            </span>
                        </div>
                    </NavLink>
                </li>
            }
        </ul>
    </div>
</section>

<section class="[ dark:bg-stone-900 ] [ flex flex-col ] [ space-y-5 ] [ p-5 ] [ border-b-2 ] [ dark:border-gray-800 ]">
    <header class="[ flex ] [ space-x-2 ]">
        <svg xmlns="http://www.w3.org/2000/svg" class="[ icon icon-tabler icon-tabler-speakerphone ] [ text-green-600 ]" width="30" height="30" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M18 8a3 3 0 0 1 0 6"></path>
            <path d="M10 8v11a1 1 0 0 1 -1 1h-1a1 1 0 0 1 -1 -1v-5"></path>
            <path d="M12 8h0l4.524 -3.77a.9 .9 0 0 1 1.476 .692v12.156a.9 .9 0 0 1 -1.476 .692l-4.524 -3.77h-8a1 1 0 0 1 -1 -1v-4a1 1 0 0 1 1 -1h8"></path>
        </svg>
        <h2 class="[ text-2xl font-bold ] [ dark:text-gray-200 ]">Announcements</h2>
    </header>
</section>

@code {
    private string Title = "I ❤️ DotNet | .NET Tutorials, C# and Blazor";
    private string Description = "Practical .NET tutorials, C# examples, Blazor guides, and hands-on learning paths for developers building real applications.";
    private string BaseUrl => configuration.GetValue<string>("baseUrl")!;
    private IEnumerable<ContentMetaData> Contents = Enumerable.Empty<ContentMetaData>();
    private string? SelectedContentType;
    private int PublishedArticleCount;
    private int PublishedChannelCount;
    private ElementReference ChannelShelf;
    private IReadOnlyList<(string Name, string IconUrl, int ArticleCount)> Channels = [];
    private int Count = 1;
    private int Take => TableOfContents.PageSize * Count;

    protected override void OnInitialized()
    {
        var publishedContents = tableOfContents.Contents;
        PublishedArticleCount = publishedContents.Count;
        PublishedChannelCount = publishedContents.Select(content => content.Channel).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        var publishedCounts = publishedContents
            .GroupBy(content => content.Channel, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
        Channels = tableOfContents.AllContents
            .GroupBy(content => content.Channel)
            .OrderBy(group => group.Key)
            .Select(group => (group.Key, group.First().IconUrl, publishedCounts.GetValueOrDefault(group.Key)))
            .ToList();
        Contents = tableOfContents.FilteredAndPagedContents();
    }

    private async Task ScrollChannelsAsync(int direction)
    {
        await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/channel-shelf.js");
        await module.InvokeVoidAsync("scrollChannels", ChannelShelf, direction);
    }

    private void FilterContent(string? selectedContentType)
    {
        SelectedContentType = selectedContentType;
        Count = 1;

        Contents = tableOfContents.FilteredAndPagedContents(selectedContentType);
    }

    private void ShowMoreContents()
    {
        Count++;
        Contents = tableOfContents.FilteredAndPagedContents(SelectedContentType, 0, Take);
    }
}