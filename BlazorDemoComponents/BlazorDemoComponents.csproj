<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
	  <PackageReference Include="Microsoft.Extensions.Configuration" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
	  <PackageReference Include="SkiaSharp.Views.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaseComponents\BaseComponents.csproj" />
  	<ProjectReference Include="..\SharedComponents\SharedComponents.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ContentGenerationChannel>Blazor</ContentGenerationChannel>
    <SitemapXmlFilePath>$([System.IO.Path]::Combine('wwwroot', 'sitemap-blog-blazor-wasm.xml'))</SitemapXmlFilePath>
    <PosterOutputPath>$([System.IO.Path]::Combine('wwwroot', 'image', 'blogs', 'blazor', 'wasm'))</PosterOutputPath>
  </PropertyGroup>

</Project>
