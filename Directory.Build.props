<Project>
    <PropertyGroup>
        <RepositoryTargetFramework>net11.0</RepositoryTargetFramework>
        <TargetFramework>$(RepositoryTargetFramework)</TargetFramework>
        <ContentGeneratorTargetFramework>$(RepositoryTargetFramework)</ContentGeneratorTargetFramework>
        <ContentGeneratorRoot>$(MSBuildThisFileDirectory)</ContentGeneratorRoot>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishTrimmed>true</PublishTrimmed>
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
        <StaticWebAssetBasePath Condition="$(StaticWebAssetBasePath) == ''">/</StaticWebAssetBasePath>
        
        <!-- Begin: Nuget Audit -->
        <NoWarn>NU1900</NoWarn>
        <WarningsNotAsErrors>NU1900</WarningsNotAsErrors>
        <NugetAudit>true</NugetAudit>
        <NugetAuditLevel>critical</NugetAuditLevel>
        <NugetAuditMode>all</NugetAuditMode>
        <!-- End: Nuget Audit -->

        <!-- Begin: ASLR Implementation - Enabled by default but no harm in explicitly mentioning -->
        <!-- Enables /DYNAMICBASE (classic ASLR) and /HIGHENTROPYVA (x64 ASLR) -->
        <ImageRandomization>true</ImageRandomization>
        <HighEntropyVA>true</HighEntropyVA>
        <!-- End: ASLR Implementation - Enabled by default but no harm in explicitly mentioning -->

        <!-- Begin: DEP Implementation - Enabled by default but no harm in explicitly mentioning -->
        <!-- enables the /NXCOMPAT header bit -->
        <NXCompat>true</NXCompat>
        <!-- End: DEP Implementation - Enabled by default but no harm in explicitly mentioning -->

        <!-- Begin: Static Code Analysis  -->
        <!-- <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode> -->
        <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors> -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.dcproj'">
            <PackageReference Include="SonarAnalyzer.CSharp" Version="*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>
                runtime; build; native; contentfiles; analyzers; buildtransitive
            </IncludeAssets>
            </PackageReference>
        </ItemGroup> -->
        <!-- End: Static Code Analysis  -->

        <!-- Begin: Set the build scope to the value of the BuildScope environment variable if it is set for generating Sitemap from other RCL -->
        <BaseIntermediateOutputPath Condition=" '$(BuildScope)' != '' ">obj\$(BuildScope)\</BaseIntermediateOutputPath>
        <IntermediateOutputPath Condition=" '$(BuildScope)' != '' ">obj\$(BuildScope)\$(Configuration)\</IntermediateOutputPath>
        <BaseOutputPath Condition=" '$(BuildScope)' != '' ">bin\$(BuildScope)\</BaseOutputPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
        <!-- End: Set the build scope to the value of the BuildScope environment variable if it is set for generating Sitemap from other RCL -->
    </PropertyGroup>
    <!-- Define shared inputs before project files consume these item lists;
         Directory.Build.targets is imported too late for those references. -->
    <ItemGroup>
        <!-- Build rules, package/SDK versions and model project settings can
             change generated assets even when article content is unchanged. -->
        <ContentBuildInput Include="$(ContentGeneratorRoot)Directory.Build.props;$(ContentGeneratorRoot)Directory.Build.targets;$(ContentGeneratorRoot)Directory.Packages.props;$(ContentGeneratorRoot)global.json;$(ContentGeneratorRoot)SharedModels\SharedModels.csproj" />
        <!-- Generated C# changes during normal compilation; including it would
             unnecessarily invalidate content generation on subsequent builds. -->
        <ContentModelInput Include="$(ContentGeneratorRoot)SharedModels\**\*.cs"
                           Exclude="$(ContentGeneratorRoot)SharedModels\bin\**;$(ContentGeneratorRoot)SharedModels\obj\**" />
    </ItemGroup>
</Project>