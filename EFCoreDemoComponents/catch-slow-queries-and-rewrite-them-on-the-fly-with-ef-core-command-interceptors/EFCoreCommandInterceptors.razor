@page "/blogs/catch-slow-queries-and-rewrite-them-on-the-fly-with-ef-core-command-interceptors"
@using BaseComponents
@inherits BasePage

<Content FileName=@nameof(EFCoreCommandInterceptors)>
    <ContentBody>
        <What>
            <p>
                A <Highlight>DbCommandInterceptor</Highlight> observes commands EF Core sends through configured contexts. It can inspect execution duration, observe failures, or modify a command before execution.
            </p>
            <p>
                This article shows command interceptors for slow-command logging, a narrowly scoped SQL Server query hint, failure telemetry, and identifying repeated commands that may indicate an N+1 query pattern.
            </p>
        </What>

        <Why>
            <p>
                With lazy loading enabled, accessing a navigation property can issue a separate database query. Repeating that access in a loop creates an <Highlight>N+1 query pattern</Highlight>: one query loads the parent rows, then additional queries load related rows.
            </p>
            <p>
                A small development dataset also hides commands that become slow with production-scale data. Central command telemetry can record timing and failure information for EF Core commands without requiring each repository to implement its own logging.
            </p>
            <p>
                Interceptors see only commands sent through contexts where they are registered. They do not observe direct ADO.NET calls or database operations outside those contexts.
            </p>
        </Why>

        <How>
            <h4>Detect slow-running commands after execution</h4>
            <p>
                <Highlight>ReaderExecutedAsync</Highlight> exposes the elapsed duration after a reader command completes. Add equivalent checks for scalar and non-query commands when those operations also need monitoring:
            </p>
            <CodeSnippet CssClass="language-csharp">
public class SlowCommandInterceptor(ILogger&lt;SlowCommandInterceptor&gt; logger) : DbCommandInterceptor
{
    private static readonly TimeSpan SlowThreshold = TimeSpan.FromSeconds(5);

    public override async ValueTask&lt;DbDataReader&gt; ReaderExecutedAsync(
        DbCommand command,
        CommandExecutedEventData eventData,
        DbDataReader result,
        CancellationToken cancellationToken = default)
    {
        var reader = await base.ReaderExecutedAsync(command, eventData, result, cancellationToken);
        WarnIfSlow(command, eventData);
        return reader;
    }

    public override async ValueTask&lt;object?&gt; ScalarExecutedAsync(
        DbCommand command,
        CommandExecutedEventData eventData,
        object? result,
        CancellationToken cancellationToken = default)
    {
        var status = await base.ScalarExecutedAsync(command, eventData, result, cancellationToken);
        WarnIfSlow(command, eventData);
        return status;
    }

    public override async ValueTask&lt;int&gt; NonQueryExecutedAsync(
        DbCommand command,
        CommandExecutedEventData eventData,
        int result,
        CancellationToken cancellationToken = default)
    {
        var resultValue = await base.NonQueryExecutedAsync(command, eventData, result, cancellationToken);
        WarnIfSlow(command, eventData);
        return resultValue;
    }

    private void WarnIfSlow(DbCommand command, CommandExecutedEventData eventData)
    {
        if (eventData.Duration &gt; SlowThreshold)
        {
            logger.LogWarning(
                "Slow command detected. Id: {CommandId}, Source: {Source}, Duration: {Duration}",
                eventData.CommandId,
                eventData.CommandSource,
                eventData.Duration);
        }
    }
}
            </CodeSnippet>
            <p>
                This interceptor has no mutable state and can be registered as a singleton if it remains thread-safe. Use a scoped instance when it depends on request-specific services.
            </p>

            <h4>Inject query hints before a command executes</h4>
            <p>
                <Highlight>ReaderExecutingAsync</Highlight> runs before an asynchronous reader command executes. This example appends a SQL Server hint only to a known, unmodified text <Highlight>SELECT</Highlight> shape; add the synchronous <Highlight>ReaderExecuting</Highlight> callback if synchronous queries also need rewriting. It is not a general SQL parser; test the generated command with the target provider and avoid applying string-based rewrites to arbitrary SQL.
            </p>
            <CodeSnippet CssClass="language-csharp">
public class JoinHintInterceptor : DbCommandInterceptor
{
    public override ValueTask&lt;InterceptionResult&lt;DbDataReader&gt;&gt; ReaderExecutingAsync(
        DbCommand command,
        CommandEventData eventData,
        InterceptionResult&lt;DbDataReader&gt; result,
        CancellationToken cancellationToken = default)
    {
        var sql = command.CommandText.Trim();
        if (command.CommandType == CommandType.Text
            &amp;&amp; sql.StartsWith("SELECT ", StringComparison.OrdinalIgnoreCase)
            &amp;&amp; sql.Contains(" JOIN ", StringComparison.OrdinalIgnoreCase)
            &amp;&amp; !sql.EndsWith(";", StringComparison.Ordinal)
            &amp;&amp; !sql.Contains(" OPTION ", StringComparison.OrdinalIgnoreCase))
        {
            command.CommandText = $"{sql} OPTION (FORCE ORDER)";
        }

        return base.ReaderExecutingAsync(command, eventData, result, cancellationToken);
    }
}
            </CodeSnippet>
            <p>
                This callback handles asynchronous reader commands; it does not rewrite updates or deletes. SQL Server query hints have provider-specific syntax and should only be used when a measured query needs them.
            </p>

            <h4>Centralize command failure telemetry</h4>
            <p>
                <Highlight>CommandFailedAsync</Highlight> runs when an intercepted command fails. Use it to add consistent telemetry while preserving the exception behavior of the calling code:
            </p>
            <CodeSnippet CssClass="language-csharp">
public class CommandFailureInterceptor(ILogger&lt;CommandFailureInterceptor&gt; logger) : DbCommandInterceptor
{
    public override async Task CommandFailedAsync(
        DbCommand command,
        CommandErrorEventData eventData,
        CancellationToken cancellationToken = default)
    {
        logger.LogError(
            "Command failed. Id: {CommandId}, Source: {Source}, ErrorType: {ErrorType}",
            eventData.CommandId,
            eventData.CommandSource,
            eventData.Exception.GetType().Name);

        return await base.CommandFailedAsync(command, eventData, cancellationToken);
    }
}
            </CodeSnippet>
            <p>
                The successful-execution callbacks above do not run for failed commands, and this example's failure callback does not record duration. Add duration reporting here if slow failures must be included. This does not replace application exception handling; the exception still propagates. Avoid logging raw SQL, parameter values, or exception messages unless your logging policy has reviewed and redacted them.
            </p>

            <h4>Watch for the same pattern on scalar and non-query commands</h4>
            <p>
                The <Highlight>SlowCommandInterceptor</Highlight> shown above already covers this by overriding all three <Highlight>Executed</Highlight> methods, so a slow schema check or a slow bulk update gets flagged exactly the same way a slow <Highlight>SELECT</Highlight> does - no separate interceptor needed.
            </p>

            <h4>Flag repeated command shapes as a possible N+1 warning</h4>
            <p>
                Lazy-loading proxies issue synchronous queries, so this example compares command text in <Highlight>ReaderExecuting</Highlight>. Repeated command text can indicate an N+1 pattern, but it can also come from legitimate repeated work.
            </p>
            <CodeSnippet CssClass="language-csharp">
public class RepeatedCommandInterceptor(ILogger&lt;RepeatedCommandInterceptor&gt; logger) : DbCommandInterceptor
{
    private string _previousCommandText = string.Empty;

    public override InterceptionResult&lt;DbDataReader&gt; ReaderExecuting(
        DbCommand command,
        CommandEventData eventData,
        InterceptionResult&lt;DbDataReader&gt; result)
    {
        if (_previousCommandText == command.CommandText)
        {
            logger.LogWarning(
                "Possible repeated query shape. Command id: {CommandId}",
                eventData.CommandId);
        }

        _previousCommandText = command.CommandText;
        return base.ReaderExecuting(command, eventData, result);
    }
}
            </CodeSnippet>
            <p>
                Treat this as a diagnostic hint, not proof of an N+1 issue. The interceptor stores state, so register it with a context-appropriate lifetime and do not share it across concurrent contexts.
            </p>
        </How>

        <Summary>
            <p>
                Key takeaways from this article:
            </p>
            <ul>
                <li><Highlight>DbCommandInterceptor</Highlight> observes EF Core commands sent through contexts where it is registered; it does not observe every database call in an application</li>
                <li><Highlight>ReaderExecutedAsync</Highlight> (and its scalar/non-query siblings) let you measure duration after execution without touching the result</li>
                <li><Highlight>ReaderExecutingAsync</Highlight> can modify a reader command before execution; keep SQL rewrites provider-specific and narrowly scoped</li>
                <li><Highlight>CommandFailedAsync</Highlight> centralizes failure telemetry for commands sent through contexts where the interceptor is registered</li>
                <li>Repeated command text can suggest an N+1 pattern, but confirm it with query tracing because the check can produce false positives</li>
            </ul>
