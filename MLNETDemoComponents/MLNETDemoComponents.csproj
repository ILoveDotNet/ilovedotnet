<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.ML" />
  </ItemGroup>

  <ItemGroup>
   <ProjectReference Include="..\BaseComponents\BaseComponents.csproj" />
   <ProjectReference Include="..\SharedComponents\SharedComponents.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ContentGenerationChannel>MLNET</ContentGenerationChannel>
    <SitemapXmlFilePath>$([System.IO.Path]::Combine('wwwroot', 'sitemap-blog-mlnet.xml'))</SitemapXmlFilePath>
    <PosterOutputPath>$([System.IO.Path]::Combine('wwwroot', 'image', 'blogs', 'mlnet'))</PosterOutputPath>
  </PropertyGroup>

</Project>